  skos:prefLabel "rozhoduje ve věcech vymezení oblastí pro chov zvěře"@cs ;
  skos:definition "Kraj v přenesené působnosti rozhoduje o vymezení oblastí pro chov zvěře."@cs ;
  dcterms:description "Kraj má pravomoc určovat, které oblasti budou vymezeny pro chov zvěře, což je klíčové pro plánování a řízení chovu zvěře."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range :Kraj .

:rozhoduje-ve-věcech-prohlášení-dalších-pozemků-za-nehonební a owl:ObjectProperty ;
  rdfs:label "rozhoduje ve věcech prohlášení dalších pozemků za nehonební"@cs ;
  skos:prefLabel "rozhoduje ve věcech prohlášení dalších pozemků za nehonební"@cs ;
  skos:definition "Kraj v přenesené působnosti rozhoduje o prohlášení dalších pozemků za nehonební."@cs ;
  dcterms:description "Kraj může prohlásit určité pozemky za nehonební, což znamená, že na těchto pozemcích není povoleno lovit zvěř."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range :Kraj .

:rozhoduje-ve-věcech-povolení-použití-dravců-jako-loveckých a owl:ObjectProperty ;
  rdfs:label "rozhoduje ve věcech povolení použití dravců jako loveckých"@cs ;
  skos:prefLabel "rozhoduje ve věcech povolení použití dravců jako loveckých"@cs ;
  skos:definition "Kraj v přenesené působnosti rozhoduje o povolení použití dravců jako loveckých."@cs ;
  dcterms:description "Kraj může povolit použití dravců pro lovecké účely, což je specifická forma lovu, která vyžaduje zvláštní povolení."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range :Kraj .

:rozhoduje-ve-věcech-uložení-opatření-k-odstranění-nedostatků-zjištěných-při-provádění-dozoru a owl:ObjectProperty ;
  rdfs:label "rozhoduje ve věcech uložení opatření k odstranění nedostatků zjištěných při provádění dozoru"@cs ;
  skos:prefLabel "rozhoduje ve věcech uložení opatření k odstranění nedostatků zjištěných při provádění dozoru"@cs ;
  skos:definition "Kraj v přenesené působnosti rozhoduje o uložení opatření k odstranění nedostatků zjištěných při provádění dozoru."@cs ;
  dcterms:description "Kraj má pravomoc nařídit opatření k nápravě nedostatků, které byly zjištěny během dozoru, což je důležité pro zajištění dodržování předpisů."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range :Kraj .

:rozhoduje-ve-věcech-poskytování-finančních-příspěvků a owl:ObjectProperty ;
  rdfs:label "rozhoduje ve věcech poskytování finančních příspěvků"@cs ;
  skos:prefLabel "rozhoduje ve věcech poskytování finančních příspěvků"@cs ;
  skos:definition "Kraj v přenesené působnosti rozhoduje o poskytování finančních příspěvků."@cs ;
  dcterms:description "Kraj může poskytovat finanční příspěvky, což může být důležité pro podporu různých aktivit v oblasti myslivosti a ochrany přírody."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range :Kraj .

:vede-agendu-týkající-se-oblastí-pro-chov-zvěře a owl:ObjectProperty ;
  rdfs:label "vede agendu týkající se oblastí pro chov zvěře"@cs ;

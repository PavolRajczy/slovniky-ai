  dcterms:description "Název honitby slouží k jednoznačné identifikaci honitby v rámci řízení o uznání honitby."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:držitel-honitby a owl:DatatypeProperty ;
  rdfs:label "držitel honitby"@cs ;
  skos:prefLabel "držitel honitby"@cs ;
  skos:definition "Držitel honitby je osoba uvedená v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Držitel honitby je osoba nebo subjekt, kterému je honitba oficiálně přidělena a který má právo ji užívat."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:výměra-honebních-pozemků a owl:DatatypeProperty ;
  rdfs:label "výměra honebních pozemků"@cs ;
  skos:prefLabel "výměra honebních pozemků"@cs ;
  skos:definition "Výměra honebních pozemků je uvedena v rozhodnutí o uznání honitby a je členěna podle druhů kultur."@cs ;
  dcterms:description "Výměra honebních pozemků určuje rozlohu pozemků, které tvoří honitbu, a je důležitá pro plánování mysliveckého hospodaření."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:popis-hranic-honitby a owl:DatatypeProperty ;
  rdfs:label "popis hranic honitby"@cs ;
  skos:prefLabel "popis hranic honitby"@cs ;
  skos:definition "Popis hranic honitby je uveden v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Popis hranic honitby slouží k přesnému vymezení území, na kterém se honitba nachází."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:vyznačení-obvodu-honitby a owl:DatatypeProperty ;
  rdfs:label "vyznačení obvodu honitby"@cs ;
  skos:prefLabel "vyznačení obvodu honitby"@cs ;
  skos:definition "Vyznačení obvodu honitby je uvedeno v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Vyznačení obvodu honitby pomáhá určit přesné hranice honitby pro účely její správy a užívání."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:výčet-a-výměry-přičleněných-honebních-pozemků a owl:DatatypeProperty ;
  rdfs:label "výčet a výměry přičleněných honebních pozemků"@cs ;
  skos:prefLabel "výčet a výměry přičleněných honebních pozemků"@cs ;
  skos:definition "Výčet a výměry honebních pozemků přičleněných k honitbě jsou uvedeny v rozhodnutí o uznání honitby, včetně jejich vlastníků a důvodů přičlenění."@cs ;
  dcterms:description "Tento výčet poskytuje informace o dalších pozemcích, které byly přidány k honitbě, a důvodech, proč byly přičleněny."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:jakostní-třídy-honitby a owl:DatatypeProperty ;
  rdfs:label "jakostní třídy honitby"@cs ;
  skos:prefLabel "jakostní třídy honitby"@cs ;
  skos:definition "Jakostní třídy honitby pro jednotlivé druhy zvěře jsou navrženy držitelem honitby a uvedeny v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Jakostní třídy určují kvalitu honitby pro různé druhy zvěře a pomáhají při plánování mysliveckého hospodaření."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:minimální-a-normované-stavy-zvěře a owl:DatatypeProperty ;
  rdfs:label "minimální a normované stavy zvěře"@cs ;
  skos:prefLabel "minimální a normované stavy zvěře"@cs ;
  skos:definition "Minimální a normované stavy zvěře jsou uvedeny v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Tyto stavy určují počet zvěře, který by měl být v honitbě udržován pro zajištění ekologické rovnováhy a efektivního mysliveckého hospodaření."@cs ;
  rdfs:domain :Řízení-o-uznání-honitby ;
  rdfs:range xsd:string .

:název-honitby a owl:DatatypeProperty ;
  rdfs:label "název honitby"@cs ;
  skos:prefLabel "název honitby"@cs ;
  skos:definition "Název honitby je oficiální označení honitby uvedené v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Název honitby slouží k jednoznačné identifikaci honitby v rámci administrativních a právních úkonů."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:držitel-honitby a owl:DatatypeProperty ;
  rdfs:label "držitel honitby"@cs ;
  skos:prefLabel "držitel honitby"@cs ;
  skos:definition "Držitel honitby je osoba nebo subjekt uvedený v rozhodnutí o uznání honitby, kterému byla honitba uznána."@cs ;
  dcterms:description "Držitel honitby má právo užívat honitbu a je zodpovědný za její správu a dodržování právních předpisů týkajících se myslivosti."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:výměra-honebních-pozemků a owl:DatatypeProperty ;
  rdfs:label "výměra honebních pozemků"@cs ;
  skos:prefLabel "výměra honebních pozemků"@cs ;
  skos:definition "Výměra honebních pozemků je celková plocha honebních pozemků uvedená v rozhodnutí o uznání honitby, členěná podle druhů kultur."@cs ;
  dcterms:description "Výměra honebních pozemků je důležitá pro určení rozsahu honitby a může ovlivnit plánování mysliveckého hospodaření."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:popis-hranic-honitby a owl:DatatypeProperty ;
  rdfs:label "popis hranic honitby"@cs ;
  skos:prefLabel "popis hranic honitby"@cs ;
  skos:definition "Popis hranic honitby je detailní určení hranic honitby uvedené v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Popis hranic je klíčový pro přesné vymezení území, na kterém lze vykonávat právo myslivosti."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:vyznačení-obvodu-honitby a owl:DatatypeProperty ;
  rdfs:label "vyznačení obvodu honitby"@cs ;
  skos:prefLabel "vyznačení obvodu honitby"@cs ;
  skos:definition "Vyznačení obvodu honitby je grafické nebo textové určení obvodu honitby uvedené v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Vyznačení obvodu pomáhá v orientaci a správě honitby, zajišťuje, že všechny zúčastněné strany mají jasnou představu o rozsahu honitby."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:výčet-a-výměry-přičleněných-honebních-pozemků a owl:DatatypeProperty ;
  rdfs:label "výčet a výměry přičleněných honebních pozemků"@cs ;
  skos:prefLabel "výčet a výměry přičleněných honebních pozemků"@cs ;
  skos:definition "Výčet a výměry přičleněných honebních pozemků jsou seznam a plocha pozemků přičleněných k honitbě, uvedené v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Tento výčet zahrnuje informace o vlastnících a důvodech přičlenění, což je důležité pro právní a administrativní účely."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:jakostní-třídy-honitby a owl:DatatypeProperty ;
  rdfs:label "jakostní třídy honitby"@cs ;
  skos:prefLabel "jakostní třídy honitby"@cs ;
  skos:definition "Jakostní třídy honitby jsou kategorie kvality honitby pro jednotlivé druhy zvěře, navržené držitelem honitby a uvedené v rozhodnutí o uznání honitby."@cs ;
  dcterms:description "Jakostní třídy pomáhají v plánování a řízení mysliveckého hospodaření, určují minimální a normované stavy zvěře."@cs ;
  rdfs:domain :Rozhodnutí-o-uznání-honitby ;
  rdfs:range xsd:string .

:rovnováha-mezi-stavy-spárkaté-zvěře-a-prostředím a owl:DatatypeProperty ;
  rdfs:label "rovnováha mezi stavy spárkaté zvěře a prostředím"@cs ;
  skos:prefLabel "rovnováha mezi stavy spárkaté zvěře a prostředím"@cs ;
  skos:definition "Rovnováha mezi stavy spárkaté zvěře a prostředím je stav, kdy populace zvěře je v souladu s kapacitou prostředí, ve kterém žije."@cs ;
  dcterms:description "Tato rovnováha zajišťuje, že počet zvěře je udržitelný a neohrožuje ani zvěř, ani její prostředí. Je důležité pro udržení ekologické stability a zdraví ekosystému."@cs ;
  rdfs:domain :Chov-zvěře ;
  rdfs:range xsd:boolean .

:přírodní-kvalita-genofondu-zvěře a owl:DatatypeProperty ;
  rdfs:label "přírodní kvalita genofondu zvěře"@cs ;
  skos:prefLabel "přírodní kvalita genofondu zvěře"@cs ;
  skos:definition "Přírodní kvalita genofondu zvěře se týká genetické rozmanitosti a zdraví populace zvěře."@cs ;
  dcterms:description "Udržování přírodní kvality genofondu je klíčové pro zajištění dlouhodobé životaschopnosti a adaptability zvěře na měnící se podmínky prostředí."@cs ;
  rdfs:domain :Chov-zvěře ;
  rdfs:range xsd:boolean .

:chovná-kvalita-zvěře a owl:DatatypeProperty ;
  rdfs:label "chovná kvalita zvěře"@cs ;
  skos:prefLabel "chovná kvalita zvěře"@cs ;
  skos:definition "Chovná kvalita zvěře se vztahuje k vlastnostem zvěře, které jsou žádoucí pro její reprodukci a přežití."@cs ;
  dcterms:description "Zvyšování chovné kvality zahrnuje selektivní chov a další opatření, která podporují zdravé a silné populace zvěře."@cs ;
  rdfs:domain :Chov-zvěře ;
  rdfs:range xsd:boolean .

:optimální-stav-zvěře a owl:DatatypeProperty ;
  rdfs:label "optimální stav zvěře"@cs ;
  skos:prefLabel "optimální stav zvěře"@cs ;
  skos:definition "Optimální stav zvěře je takový počet jedinců, který je ideální pro dané prostředí a zajišťuje rovnováhu mezi zvěří a jejím prostředím."@cs ;
  dcterms:description "Optimální stav je důležitý pro udržení zdravého ekosystému a zajištění, že zvěř má dostatek zdrojů pro přežití a reprodukci."@cs ;
  rdfs:domain :Chov-zvěře ;
  rdfs:range xsd:boolean .

:populační-hustota-pro-minimální-stav-zvěře a owl:DatatypeProperty ;
  rdfs:label "populační hustota pro minimální stav zvěře"@cs ;
  skos:prefLabel "populační hustota pro minimální stav zvěře"@cs ;
  skos:definition "Populační hustota, která zabezpečuje biologickou reprodukci druhu a zajišťuje, že druh není ohrožen na existenci."@cs ;
  dcterms:description "Populační hustota je klíčová pro udržení druhu v přírodě. Musí být dostatečná, aby umožnila přirozenou reprodukci a přežití druhu bez ohrožení jeho existence."@cs ;
  rdfs:domain :Minimální-stav-zvěře ;
  rdfs:range xsd:integer .

:nejvýše-přípustný-jarní-stav-zvěře a owl:DatatypeProperty ;
  rdfs:label "nejvýše přípustný jarní stav zvěře"@cs ;
  skos:prefLabel "nejvýše přípustný jarní stav zvěře"@cs ;
  skos:definition "Nejvýše přípustný jarní stav zvěře, který odpovídá kvalitě životního prostředí zvěře a úživnosti honitby."@cs ;
  dcterms:description "Tento stav určuje maximální počet jedinců zvěře, který je udržitelný v daném prostředí a zajišťuje, že nedojde k přetížení zdrojů v honitbě."@cs ;
  rdfs:domain :Normovaný-stav-zvěře ;
  rdfs:range xsd:integer .

:požadovaný-poměr-pohlaví-zvěře a owl:DatatypeProperty ;
  rdfs:label "požadovaný poměr pohlaví zvěře"@cs ;
  skos:prefLabel "požadovaný poměr pohlaví zvěře"@cs ;
  skos:definition "Požadovaný poměr pohlaví zvěře v rámci jakostní třídy honitby."@cs ;
  dcterms:description "Poměr pohlaví je důležitý pro udržení zdravé a reprodukčně schopné populace zvěře."@cs ;
  rdfs:domain :Normovaný-stav-zvěře ;
  rdfs:range xsd:string .

:věková-skladba-zvěře a owl:DatatypeProperty ;
  rdfs:label "věková skladba zvěře"@cs ;
  skos:prefLabel "věková skladba zvěře"@cs ;
  skos:definition "Věková skladba zvěře v rámci jakostní třídy honitby."@cs ;
  dcterms:description "Věková skladba populace zvěře je klíčová pro její dlouhodobou udržitelnost a reprodukční schopnost."@cs ;
  rdfs:domain :Normovaný-stav-zvěře ;
  rdfs:range xsd:string .

:koeficient-očekávané-produkce-zvěře a owl:DatatypeProperty ;
  rdfs:label "koeficient očekávané produkce zvěře"@cs ;
  skos:prefLabel "koeficient očekávané produkce zvěře"@cs ;
  skos:definition "Koeficient očekávané produkce zvěře v rámci jakostní třídy honitby."@cs ;
  dcterms:description "Tento koeficient pomáhá odhadnout, kolik zvěře může být udržitelně produkováno v dané honitbě."@cs ;
  rdfs:domain :Normovaný-stav-zvěře ;
  rdfs:range xsd:integer .

:přírodní-podmínky-oblasti-chovu-zvěře a owl:DatatypeProperty ;
  rdfs:label "přírodní podmínky oblasti chovu zvěře"@cs ;
  skos:prefLabel "přírodní podmínky oblasti chovu zvěře"@cs ;
  skos:definition "Přírodní podmínky oblasti chovu zvěře jsou přibližně stejné vhodné podmínky pro zvěř v souvislém území tvořeném souborem honiteb."@cs ;
  dcterms:description "Přírodní podmínky zahrnují faktory jako klima, vegetace a dostupnost vody, které jsou důležité pro udržení zdravé populace zvěře v oblasti chovu."@cs ;
  rdfs:domain :Oblast-chovu-zvěře ;
  rdfs:range xsd:string .

:druh-zvěře-v-oblasti-chovu a owl:DatatypeProperty ;
  rdfs:label "druh zvěře v oblasti chovu"@cs ;
  skos:prefLabel "druh zvěře v oblasti chovu"@cs ;
  skos:definition "Druh zvěře v oblasti chovu je určený druh spárkaté zvěře nebo vzácné či ohrožené druhy zvěře, které jsou chovány v oblasti."@cs ;
  dcterms:description "Oblast chovu může být určena pro specifické druhy zvěře, jako jsou tetřev, tetřívek nebo jeřábek, s výjimkou běžných druhů jako srnčí zvěř, jelenec a prase divoké."@cs ;
  rdfs:domain :Oblast-chovu-zvěře ;
  rdfs:range xsd:string .

:zánik-společenstevní-honitby a owl:DatatypeProperty ;
  rdfs:label "zánik společenstevní honitby"@cs ;
  skos:prefLabel "zánik společenstevní honitby"@cs ;
  skos:definition "Společenstevní honitba zaniká, pokud honební společenstvo nepřijme stanovy a nezvolí orgány do 9 měsíců ode dne účinnosti zákona."@cs ;
  dcterms:description "Společenstevní honitba může zaniknout, pokud honební společenstvo nesplní povinnost přijmout stanovy a zvolit orgány v dané lhůtě. Po zániku honebního společenstva následuje likvidace."@cs ;
  rdfs:domain :Společenstevní-honitba ;
  rdfs:range xsd:boolean .

:splatnost-náhrady a owl:DatatypeProperty ;
  rdfs:label "splatnost náhrady"@cs ;
  skos:prefLabel "splatnost náhrady"@cs ;
  skos:definition "Náhrada je splatná do 31. března běžného roku zpětně."@cs ;
  dcterms:description "Splatnost náhrady určuje, do kdy musí být finanční kompenzace uhrazena vlastníkům přičleněných honebních pozemků. Tato lhůta je stanovena na 31. března každého roku za předchozí rok."@cs ;
  rdfs:domain :Náhrada ;
  rdfs:range xsd:date .

:výše-náhrady a owl:DatatypeProperty ;
  rdfs:label "výše náhrady"@cs ;
  skos:prefLabel "výše náhrady"@cs ;
  skos:definition "Výše náhrady je určena orgánem státní správy myslivosti, pokud se zúčastněné osoby nedohodnou."@cs ;
  dcterms:description "Výše náhrady je částka, kterou držitel honitby nebo honební společenstvo platí vlastníkům přičleněných honebních pozemků. Pokud se zúčastněné strany nedohodnou na částce, určí ji orgán státní správy myslivosti s ohledem na velikost přičleněných pozemků a předpokládaný výnos z výkonu práva myslivosti."@cs ;
  rdfs:domain :Náhrada ;
  rdfs:range xsd:integer .

:hranice-honitby a owl:DatatypeProperty ;
  rdfs:label "hranice honitby"@cs ;
  skos:prefLabel "hranice honitby"@cs ;
  skos:definition "Hranice honitby jsou územní linie, které vymezují rozsah honitby."@cs ;
  dcterms:description "Hranice honitby mohou být upraveny vyrovnáváním nebo výměnou honebních pozemků, aniž by se muselo přihlížet k územním hranicím obcí, okresů nebo krajů."@cs ;
  rdfs:domain :Změna-honitby ;
  rdfs:range xsd:string .

:výměra-směňovaných-pozemků a owl:DatatypeProperty ;
  rdfs:label "výměra směňovaných pozemků"@cs ;
  skos:prefLabel "výměra směňovaných pozemků"@cs ;
  skos:definition "Výměra směňovaných pozemků je rozloha pozemků, které jsou v rámci změny honitby vyměňovány."@cs ;
  dcterms:description "Při změně honitby nemusí být výměry směňovaných pozemků stejné, což umožňuje flexibilitu při úpravě hranic honitby."@cs ;
  rdfs:domain :Změna-honitby ;
  rdfs:range xsd:integer .

:datum-provedení-změny-honitby a owl:DatatypeProperty ;
  rdfs:label "datum provedení změny honitby"@cs ;
  skos:prefLabel "datum provedení změny honitby"@cs ;
  skos:definition "Datum, ke kterému je změna honitby provedena orgánem státní správy myslivosti."@cs ;
  dcterms:description "Změna honitby vyplývající ze změn vlastnictví honebních pozemků je provedena vždy k 31. prosinci roku následujícího po roce, v němž vlastník o úpravu požádal."@cs ;
  rdfs:domain :Změna-honitby ;
  rdfs:range xsd:date .

:důvod-zániku-honitby a owl:DatatypeProperty ;
  rdfs:label "důvod zániku honitby"@cs ;
  skos:prefLabel "důvod zániku honitby"@cs ;
  skos:definition "Důvod, proč honitba zaniká, může zahrnovat zrušení, sloučení nebo rozdělení honitby, zrušení honebního společenstva, pokles výměry pod minimální výměru nebo prohlášení pozemků za nehonební."@cs ;
  dcterms:description "Důvod zániku honitby je klíčový pro určení, proč honitba přestává existovat. Může se jednat o administrativní změny, jako je zrušení honebního společenstva, nebo o změny ve vlastnictví pozemků, které vedou k poklesu výměry pod zákonem stanovenou minimální hodnotu."@cs ;
  rdfs:domain :Zánik-honitby ;
  rdfs:range xsd:string .

:datum-zániku-honitby a owl:DatatypeProperty ;
  rdfs:label "datum zániku honitby"@cs ;
  skos:prefLabel "datum zániku honitby"@cs ;
  skos:definition "Datum, ke kterému honitba zaniká, je stanoveno na 31. prosince roku následujícího po roce, v němž došlo k události vedoucí k zániku."@cs ;
  dcterms:description "Datum zániku honitby je důležité pro právní účely a určuje, kdy honitba oficiálně přestává existovat. Toto datum je pevně stanoveno na konec roku následujícího po roce, kdy došlo k události, která způsobila zánik."@cs ;
  rdfs:domain :Zánik-honitby ;
  rdfs:range xsd:date .

:podmínky-nájmu-honitby a owl:DatatypeProperty ;
  rdfs:label "podmínky nájmu honitby"@cs ;
  skos:prefLabel "podmínky nájmu honitby"@cs ;
  skos:definition "Podmínky nájmu honitby jsou sděleny držitelem honitby všem zájemcům o nájem honitby."@cs ;
  dcterms:description "Podmínky nájmu zahrnují veškeré požadavky a pravidla, které musí zájemci splnit, aby mohli být považováni za potenciální nájemce honitby."@cs ;
  rdfs:domain :Výběrové-řízení ;
  rdfs:range xsd:string .

:rozhodnutí-o-nejlepším-zájemci a owl:DatatypeProperty ;
  rdfs:label "rozhodnutí o nejlepším zájemci"@cs ;
  skos:prefLabel "rozhodnutí o nejlepším zájemci"@cs ;
  skos:definition "Rozhodnutí o tom, který ze zájemců prokázal nejlepší záměr, mysliveckou odbornost, praxi a důvěryhodnost, je sděleno všem zájemcům."@cs ;
  dcterms:description "Toto rozhodnutí určuje, který zájemce je považován za nejvhodnějšího pro nájem honitby na základě jeho kvalifikací a záměrů."@cs ;
  rdfs:domain :Výběrové-řízení ;
  rdfs:range xsd:string .

:výše-ceny-nájmu-honitby a owl:DatatypeProperty ;
  rdfs:label "výše ceny nájmu honitby"@cs ;
  skos:prefLabel "výše ceny nájmu honitby"@cs ;
  skos:definition "Výše ceny, za kterou je honitba vybranému zájemci pronajímána, je sdělena všem zájemcům."@cs ;
  dcterms:description "Cena nájmu je klíčovým faktorem při rozhodování o nájemci a je transparentně sdělena všem zájemcům."@cs ;
  rdfs:domain :Výběrové-řízení ;
  rdfs:range xsd:string .

:obsah-uzavřené-smlouvy a owl:DatatypeProperty ;
  rdfs:label "obsah uzavřené smlouvy"@cs ;
  skos:prefLabel "obsah uzavřené smlouvy"@cs ;
  skos:definition "Plný obsah uzavřené smlouvy s vybraným nájemcem je sdělen všem zájemcům."@cs ;
  dcterms:description "Toto sdělení zajišťuje transparentnost procesu výběrového řízení a informuje všechny zájemce o podmínkách, na kterých byla smlouva uzavřena."@cs ;
  rdfs:domain :Výběrové-řízení ;
  rdfs:range xsd:string .

:doba-trvání-smlouvy a owl:DatatypeProperty ;
  rdfs:label "doba trvání smlouvy"@cs ;
  skos:prefLabel "doba trvání smlouvy"@cs ;
  skos:definition "Doba, na kterou je smlouva o nájmu honitby uzavřena, je 10 let."@cs ;
  dcterms:description "Smlouva o nájmu honitby musí být uzavřena na pevně stanovenou dobu 10 let, což znamená, že po uplynutí této doby smlouva zaniká, pokud není obnovena."@cs ;
  rdfs:domain :Smlouva-o-nájmu-honitby ;
  rdfs:range xsd:integer .

:datum-zaslání-smlouvy-orgánu-státní-správy-myslivosti a owl:DatatypeProperty ;
  rdfs:label "datum zaslání smlouvy orgánu státní správy myslivosti"@cs ;
  skos:prefLabel "datum zaslání smlouvy orgánu státní správy myslivosti"@cs ;
  skos:definition "Datum, do kterého je držitel honitby povinen zaslat jedno vyhotovení smlouvy orgánu státní správy myslivosti, je do 15 dnů ode dne uzavření smlouvy."@cs ;
  dcterms:description "Držitel honitby má povinnost informovat orgán státní správy myslivosti o uzavření smlouvy o nájmu honitby zasláním jejího vyhotovení do 15 dnů od uzavření."@cs ;
  rdfs:domain :Smlouva-o-nájmu-honitby ;
  rdfs:range xsd:date .

:nájemné-z-honitby a owl:DatatypeProperty ;
  rdfs:label "nájemné z honitby"@cs ;
  skos:prefLabel "nájemné z honitby"@cs ;
  skos:definition "Nájemné z honitby se stanoví dohodou smluvních stran, pokud zákon nestanoví jinak."@cs ;
  dcterms:description "Výše nájemného za honitbu je předmětem dohody mezi pronajímatelem a nájemcem, pokud není jinak určeno zákonem."@cs ;
  rdfs:domain :Smlouva-o-nájmu-honitby ;
  rdfs:range xsd:string .

:způsob-zániku-smlouvy a owl:DatatypeProperty ;
  rdfs:label "způsob zániku smlouvy"@cs ;
  skos:prefLabel "způsob zániku smlouvy"@cs ;
  skos:definition "Smlouva o nájmu honitby zaniká uplynutím doby, zánikem honitby, zánikem nebo smrtí nájemce, nesplněním podmínek, dohodou, výpovědí nebo rozhodnutím orgánu státní správy myslivosti."@cs ;
  dcterms:description "Existuje několik způsobů, jak může smlouva o nájmu honitby zaniknout, včetně uplynutí doby, zániku honitby, smrti nájemce, nesplnění podmínek, vzájemné dohody, výpovědi nebo rozhodnutí orgánu státní správy myslivosti."@cs ;
  rdfs:domain :Smlouva-o-nájmu-honitby ;
  rdfs:range xsd:string .

:datum-oznámení-zániku-smlouvy a owl:DatatypeProperty ;
  rdfs:label "datum oznámení zániku smlouvy"@cs ;
  skos:prefLabel "datum oznámení zániku smlouvy"@cs ;
  skos:definition "Datum, do kterého je držitel honitby povinen oznámit orgánu státní správy myslivosti zánik smlouvy, je do 15 dnů ode dne, kdy k zániku došlo."@cs ;
  dcterms:description "Držitel honitby musí písemně oznámit orgánu státní správy myslivosti zánik smlouvy o nájmu honitby do 15 dnů od zániku smlouvy."@cs ;
  rdfs:domain :Smlouva-o-nájmu-honitby ;
  rdfs:range xsd:date .

:osobní-údaje-mysliveckých-hospodářů a owl:DatatypeProperty ;
  rdfs:label "osobní údaje mysliveckých hospodářů"@cs ;
  skos:prefLabel "osobní údaje mysliveckých hospodářů"@cs ;
  skos:definition "Osobní údaje mysliveckých hospodářů vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Osobní údaje mysliveckých hospodářů mohou zahrnovat jméno, příjmení, adresu a další identifikační údaje potřebné pro správu honiteb."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:string .

:datum-jmenování-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "datum jmenování mysliveckého hospodáře"@cs ;
  skos:prefLabel "datum jmenování mysliveckého hospodáře"@cs ;
  skos:definition "Datum jmenování mysliveckého hospodáře vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byl myslivecký hospodář oficiálně jmenován do své funkce, je důležitou informací pro sledování jeho působnosti."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:datum-odvolání-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "datum odvolání mysliveckého hospodáře"@cs ;
  skos:prefLabel "datum odvolání mysliveckého hospodáře"@cs ;
  skos:definition "Datum odvolání mysliveckého hospodáře vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byl myslivecký hospodář oficiálně odvolán ze své funkce, je důležitou informací pro ukončení jeho působnosti."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:datum-vydání-průkazu-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "datum vydání průkazu mysliveckého hospodáře"@cs ;
  skos:prefLabel "datum vydání průkazu mysliveckého hospodáře"@cs ;
  skos:definition "Datum vydání průkazu mysliveckého hospodáře vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byl mysliveckému hospodáři vydán průkaz, který ho opravňuje k výkonu jeho funkce."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:osobní-údaje-mysliveckých-stráží a owl:DatatypeProperty ;
  rdfs:label "osobní údaje mysliveckých stráží"@cs ;
  skos:prefLabel "osobní údaje mysliveckých stráží"@cs ;
  skos:definition "Osobní údaje mysliveckých stráží vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Osobní údaje mysliveckých stráží mohou zahrnovat jméno, příjmení, adresu a další identifikační údaje potřebné pro správu honiteb."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:string .

:datum-jmenování-myslivecké-stráže a owl:DatatypeProperty ;
  rdfs:label "datum jmenování myslivecké stráže"@cs ;
  skos:prefLabel "datum jmenování myslivecké stráže"@cs ;
  skos:definition "Datum jmenování myslivecké stráže vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byla myslivecká stráž oficiálně jmenována do své funkce, je důležitou informací pro sledování její působnosti."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:datum-odvolání-myslivecké-stráže a owl:DatatypeProperty ;
  rdfs:label "datum odvolání myslivecké stráže"@cs ;
  skos:prefLabel "datum odvolání myslivecké stráže"@cs ;
  skos:definition "Datum odvolání myslivecké stráže vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byla myslivecká stráž oficiálně odvolána ze své funkce, je důležitou informací pro ukončení její působnosti."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:datum-vydání-průkazu-myslivecké-stráže a owl:DatatypeProperty ;
  rdfs:label "datum vydání průkazu myslivecké stráže"@cs ;
  skos:prefLabel "datum vydání průkazu myslivecké stráže"@cs ;
  skos:definition "Datum vydání průkazu myslivecké stráže vedené v evidenci využití honiteb."@cs ;
  dcterms:description "Datum, kdy byla myslivecké stráži vydán průkaz, který ji opravňuje k výkonu její funkce."@cs ;
  rdfs:domain :Evidence-využití-honiteb ;
  rdfs:range xsd:date .

:věk-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "věk mysliveckého hospodáře"@cs ;
  skos:prefLabel "věk mysliveckého hospodáře"@cs ;
  skos:definition "Věk mysliveckého hospodáře musí být starší 21 let."@cs ;
  dcterms:description "Myslivecký hospodář musí být starší 21 let, aby mohl vykonávat svou funkci. Tento věkový limit zajišťuje, že osoba má dostatečnou zralost a zkušenosti pro plnění povinností spojených s mysliveckým hospodařením."@cs ;
  rdfs:domain :Myslivecký-hospodář ;
  rdfs:range xsd:integer .

:bydliště-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "bydliště mysliveckého hospodáře"@cs ;
  skos:prefLabel "bydliště mysliveckého hospodáře"@cs ;
  skos:definition "Myslivecký hospodář musí mít bydliště na území České republiky."@cs ;
  dcterms:description "Bydliště na území České republiky je nutné pro výkon funkce mysliveckého hospodáře, aby byla zajištěna jeho dostupnost a znalost místních podmínek."@cs ;
  rdfs:domain :Myslivecký-hospodář ;
  rdfs:range xsd:string .

:platnost-loveckého-lístku-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "platnost loveckého lístku mysliveckého hospodáře"@cs ;
  skos:prefLabel "platnost loveckého lístku mysliveckého hospodáře"@cs ;
  skos:definition "Myslivecký hospodář musí mít platný lovecký lístek."@cs ;
  dcterms:description "Platný lovecký lístek je nezbytný pro výkon funkce mysliveckého hospodáře, protože dokládá oprávnění k lovu a znalost pravidel myslivosti."@cs ;
  rdfs:domain :Myslivecký-hospodář ;
  rdfs:range xsd:boolean .

:platnost-zbrojního-průkazu-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "platnost zbrojního průkazu mysliveckého hospodáře"@cs ;
  skos:prefLabel "platnost zbrojního průkazu mysliveckého hospodáře"@cs ;
  skos:definition "Myslivecký hospodář musí mít platný zbrojní průkaz skupiny C."@cs ;
  dcterms:description "Platný zbrojní průkaz skupiny C je nutný pro mysliveckého hospodáře, aby mohl legálně používat lovecké zbraně při výkonu své činnosti."@cs ;
  rdfs:domain :Myslivecký-hospodář ;
  rdfs:range xsd:boolean .

:pojištění-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "pojištění mysliveckého hospodáře"@cs ;
  skos:prefLabel "pojištění mysliveckého hospodáře"@cs ;
  skos:definition "Myslivecký hospodář musí být pojištěn."@cs ;
  dcterms:description "Pojištění je povinné pro mysliveckého hospodáře, aby byla zajištěna ochrana proti možným škodám způsobeným při výkonu jeho činnosti."@cs ;
  rdfs:domain :Myslivecký-hospodář ;
  rdfs:range xsd:boolean .

:vzor-průkazu-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "vzor průkazu mysliveckého hospodáře"@cs ;
  skos:prefLabel "vzor průkazu mysliveckého hospodáře"@cs ;
  skos:definition "Vzor průkazu mysliveckého hospodáře je stanoven vyhláškou."@cs ;
  dcterms:description "Vzor průkazu určuje, jak má průkaz mysliveckého hospodáře vypadat, včetně jeho formátu a obsahu. Tento vzor je důležitý pro zajištění jednotnosti a snadné identifikace průkazu."@cs ;
  rdfs:domain :Průkaz-mysliveckého-hospodáře ;
  rdfs:range xsd:string .

:zabezpečení-průkazu-mysliveckého-hospodáře a owl:DatatypeProperty ;
  rdfs:label "zabezpečení průkazu mysliveckého hospodáře"@cs ;
  skos:prefLabel "zabezpečení průkazu mysliveckého hospodáře"@cs ;
  skos:definition "Průkaz mysliveckého hospodáře musí být zabezpečen proti zneužití, ztrátě a odcizení."@cs ;
  dcterms:description "Zabezpečení průkazu zahrnuje opatření, která mají zabránit jeho neoprávněnému použití, ztrátě nebo krádeži. Myslivecký hospodář je povinen zajistit, aby průkaz nebyl zneužit."@cs ;
  rdfs:domain :Průkaz-mysliveckého-hospodáře ;
  rdfs:range xsd:boolean .

:typ-zkoušky-z-myslivosti a owl:DatatypeProperty ;
  rdfs:label "typ zkoušky z myslivosti"@cs ;
  skos:prefLabel "typ zkoušky z myslivosti"@cs ;
  skos:definition "Typ zkoušky z myslivosti, kterou musí žadatel úspěšně složit, aby prokázal odbornou způsobilost v oblasti myslivosti."@cs ;
  dcterms:description "Zkouška z myslivosti může být složena na vysoké škole, kde je myslivost vyučovacím předmětem, na střední odborné škole nebo vyšší odborné škole, kde je myslivost studijním oborem nebo povinným vyučovacím předmětem. Může se jednat také o vyšší odbornou mysliveckou zkoušku nebo zkoušku pro myslivecké hospodáře."@cs ;
  rdfs:domain :Zkouška-z-myslivosti ;
  rdfs:range xsd:string .

:potvrzení-o-složení-zkoušky-z-myslivosti a owl:DatatypeProperty ;
  rdfs:label "potvrzení o složení zkoušky z myslivosti"@cs ;
  skos:prefLabel "potvrzení o složení zkoušky z myslivosti"@cs ;
  skos:definition "Potvrzení o složení zkoušky z myslivosti vystavené jejím pořadatelem, které je veřejnou listinou."@cs ;
  dcterms:description "Potvrzení o složení zkoušky z myslivosti je oficiální dokument, který dokládá úspěšné složení zkoušky. U cizinců se za průkaz o složení zkoušky z myslivosti považuje platný doklad opravňující k lovu vystavený v cizině."@cs ;
  rdfs:domain :Zkouška-z-myslivosti ;
  rdfs:range xsd:string .

:celkový-stav-ekosystému a owl:DatatypeProperty ;
  rdfs:label "celkový stav ekosystému"@cs ;
  skos:prefLabel "celkový stav ekosystému"@cs ;
  skos:definition "Celkový stav ekosystému je jedním z faktorů, ze kterých uživatel honitby vychází při vypracování plánu mysliveckého hospodaření."@cs ;
  dcterms:description "Celkový stav ekosystému zahrnuje hodnocení přírodních podmínek a rovnováhy v honitbě, které ovlivňují myslivecké hospodaření."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:výše-škod-způsobených-zvěří a owl:DatatypeProperty ;
  rdfs:label "výše škod způsobených zvěří"@cs ;
  skos:prefLabel "výše škod způsobených zvěří"@cs ;
  skos:definition "Výše škod způsobených zvěří na lesních a zemědělských porostech v uplynulém období je zohledněna při vypracování plánu mysliveckého hospodaření."@cs ;
  dcterms:description "Tento údaj pomáhá určit, jaké škody zvěř způsobila v minulosti, což je důležité pro plánování opatření v péči o zvěř a ochranu porostů."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:integer .

:poměry-pohlaví-zvěře a owl:DatatypeProperty ;
  rdfs:label "poměry pohlaví zvěře"@cs ;
  skos:prefLabel "poměry pohlaví zvěře"@cs ;
  skos:definition "Poměry pohlaví zvěře jsou jedním z faktorů, které se berou v úvahu při vypracování plánu mysliveckého hospodaření."@cs ;
  dcterms:description "Poměry pohlaví zvěře ovlivňují reprodukční schopnosti populace a jsou důležité pro udržení zdravé populace zvěře."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:koeficienty-očekávané-produkce a owl:DatatypeProperty ;
  rdfs:label "koeficienty očekávané produkce"@cs ;
  skos:prefLabel "koeficienty očekávané produkce"@cs ;
  skos:definition "Koeficienty očekávané produkce jsou jedním z faktorů, které se berou v úvahu při vypracování plánu mysliveckého hospodaření."@cs ;
  dcterms:description "Tyto koeficienty pomáhají odhadnout budoucí přírůstky zvěře a plánovat lov a péči o zvěř."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:zamýšlené-zazvěřování a owl:DatatypeProperty ;
  rdfs:label "zamýšlené zazvěřování"@cs ;
  skos:prefLabel "zamýšlené zazvěřování"@cs ;
  skos:definition "Zamýšlené zazvěřování je součástí plánu mysliveckého hospodaření, které se týká plánovaného doplňování populace zvěře."@cs ;
  dcterms:description "Zamýšlené zazvěřování zahrnuje plány na doplnění nebo zvýšení počtu zvěře v honitbě, což může zahrnovat introdukci nových jedinců."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:výstavba-mysliveckých-zařízení a owl:DatatypeProperty ;
  rdfs:label "výstavba mysliveckých zařízení"@cs ;
  skos:prefLabel "výstavba mysliveckých zařízení"@cs ;
  skos:definition "Výstavba mysliveckých zařízení je součástí plánu mysliveckého hospodaření, která se týká plánované výstavby zařízení pro myslivost."@cs ;
  dcterms:description "Tato část plánu zahrnuje plány na výstavbu nových zařízení, jako jsou krmelce, zásypy, slaniska a napajedla, které podporují péči o zvěř."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:opatření-v-péči-o-zvěř a owl:DatatypeProperty ;
  rdfs:label "opatření v péči o zvěř"@cs ;
  skos:prefLabel "opatření v péči o zvěř"@cs ;
  skos:definition "Opatření v péči o zvěř jsou součástí plánu mysliveckého hospodaření, která se týká plánovaných aktivit pro zlepšení podmínek pro zvěř."@cs ;
  dcterms:description "Tato opatření zahrnují aktivity zaměřené na zajištění dostatečné potravy, vody a úkrytů pro zvěř, což přispívá k jejímu zdraví a reprodukci."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:opatření-při-ochraně-a-zlepšování-životních-podmínek-zvěře a owl:DatatypeProperty ;
  rdfs:label "opatření při ochraně a zlepšování životních podmínek zvěře"@cs ;
  skos:prefLabel "opatření při ochraně a zlepšování životních podmínek zvěře"@cs ;
  skos:definition "Opatření při ochraně a zlepšování životních podmínek zvěře jsou součástí plánu mysliveckého hospodaření."@cs ;
  dcterms:description "Tato opatření zahrnují aktivity zaměřené na ochranu a zlepšení prostředí, ve kterém zvěř žije, což může zahrnovat úpravy krajiny a ochranu před predátory."@cs ;
  rdfs:domain :Plán-mysliveckého-hospodaření ;
  rdfs:range xsd:string .

:termín-sčítání-zvěře a owl:DatatypeProperty ;
  rdfs:label "termín sčítání zvěře"@cs ;
  skos:prefLabel "termín sčítání zvěře"@cs ;
  skos:definition "Termín, ve kterém je uživatel honitby povinen provést sčítání zvěře v honitbě, je stanoven orgánem státní správy myslivosti."@cs ;
  dcterms:description "Termín sčítání zvěře je konkrétní datum nebo období, kdy musí být sčítání provedeno. Tento termín je určen orgánem státní správy myslivosti a je závazný pro uživatele honitby."@cs ;
  rdfs:domain :Sčítání-zvěře ;
  rdfs:range xsd:string .

:výsledek-sčítání-zvěře a owl:DatatypeProperty ;
  rdfs:label "výsledek sčítání zvěře"@cs ;
  skos:prefLabel "výsledek sčítání zvěře"@cs ;
  skos:definition "Výsledek sčítání zvěře je počet zvěře zjištěný v honitbě, který musí být písemně oznámen příslušnému orgánu státní správy myslivosti do 5 dnů po sčítání."@cs ;
  dcterms:description "Výsledek sčítání zvěře zahrnuje počet jednotlivých druhů zvěře zjištěných v honitbě. Tento výsledek je důležitý pro plánování mysliveckého hospodaření a musí být oznámen orgánu státní správy myslivosti."@cs ;
  rdfs:domain :Sčítání-zvěře ;
  rdfs:range xsd:string .

:nesouhlas-s-výsledkem-sčítání a owl:DatatypeProperty ;
  rdfs:label "nesouhlas s výsledkem sčítání"@cs ;
  skos:prefLabel "nesouhlas s výsledkem sčítání"@cs ;
  skos:definition "Nesouhlas s výsledkem sčítání je písemné oznámení držitele honitby orgánu státní správy myslivosti, pokud nesouhlasí s výsledkem provedeného sčítání, a to nejpozději do 1 týdne ode dne provedeného sčítání."@cs ;
  dcterms:description "Pokud držitel honitby nesouhlasí s výsledkem sčítání, má právo tento nesouhlas písemně oznámit orgánu státní správy myslivosti. Tímto krokem může být nařízeno nové konečné sčítání."@cs ;
  rdfs:domain :Sčítání-zvěře ;
  rdfs:range xsd:boolean .

:druh-změny-plánu a owl:DatatypeProperty ;
  rdfs:label "druh změny plánu"@cs ;
  skos:prefLabel "druh změny plánu"@cs ;
  skos:definition "Druh změny plánu určuje, zda se jedná o snížení stavů zvěře, zrušení chovu některého druhu zvěře nebo povolení lovu zvěře v době hájení."@cs ;
  dcterms:description "Druh změny plánu specifikuje konkrétní typ rozhodnutí, které bylo přijato orgánem státní správy myslivosti. Může se jednat o snížení počtu zvěře v honitbě, ukončení chovu určitého druhu zvěře nebo povolení lovu v době, kdy je zvěř obvykle chráněna."@cs ;
  rdfs:domain :Změna-plánu ;
  rdfs:range xsd:string .

:zvěř-získaná-lovem-na-nehonebních-pozemcích a owl:DatatypeProperty ;
  rdfs:label "zvěř získaná lovem na nehonebních pozemcích"@cs ;
  skos:prefLabel "zvěř získaná lovem na nehonebních pozemcích"@cs ;
  skos:definition "Zvěř, která byla získána lovem na pozemcích, které nejsou součástí honitby."@cs ;
  dcterms:description "Tato zvěř je ulovena mimo vymezené honitby, což může zahrnovat různé typy pozemků, které nejsou určeny pro běžný lov."@cs ;
  rdfs:domain :Plnění-plánu ;
  rdfs:range xsd:integer .

:zvěř-získaná-při-dohledávce a owl:DatatypeProperty ;
  rdfs:label "zvěř získaná při dohledávce"@cs ;
  skos:prefLabel "zvěř získaná při dohledávce"@cs ;
  skos:definition "Zvěř, která byla získána při dohledávce zvěře."@cs ;
  dcterms:description "Dohledávka zvěře se týká procesu hledání a získávání zvěře, která byla zraněna nebo jinak ztracena během lovu."@cs ;
  rdfs:domain :Plnění-plánu ;
  rdfs:range xsd:integer .

:nalezená-zvěř-uhynulá a owl:DatatypeProperty ;
  rdfs:label "nalezená zvěř uhynulá"@cs ;
  skos:prefLabel "nalezená zvěř uhynulá"@cs ;
  skos:definition "Zvěř, která byla nalezena uhynulá."@cs ;
  dcterms:description "Tato zvěř nebyla ulovena, ale nalezena již mrtvá, což může být důležité pro sledování stavu populace a zdraví ekosystému."@cs ;
  rdfs:domain :Plnění-plánu ;
  rdfs:range xsd:integer .

:uživatel-honitby a owl:DatatypeProperty ;
  rdfs:label "uživatel honitby"@cs ;
  skos:prefLabel "uživatel honitby"@cs ;
  skos:definition "Uživatel honitby je osoba nebo subjekt, který je povinen vést záznamy o honitbě a mysliveckém hospodaření v ní."@cs ;
  dcterms:description "Uživatel honitby je zodpovědný za vedení myslivecké evidence a podávání hlášení orgánu státní správy myslivosti pro statistické účely."@cs ;
  rdfs:domain :Myslivecká-evidence ;
  rdfs:range xsd:string .

:statistické-hlášení a owl:DatatypeProperty ;
  rdfs:label "statistické hlášení"@cs ;
  skos:prefLabel "statistické hlášení"@cs ;
  skos:definition "Statistické hlášení je dokument, který uživatel honitby podává orgánu státní správy myslivosti pro statistické účely."@cs ;
  dcterms:description "Statistické hlášení obsahuje data o honitbě a mysliveckém hospodaření, která jsou využívána pro rezortní statistické zjišťování."@cs ;
  rdfs:domain :Myslivecká-evidence ;
  rdfs:range xsd:string .

:minimální-stav-zvěře a owl:DatatypeProperty ;
  rdfs:label "minimální stav zvěře"@cs ;
  skos:prefLabel "minimální stav zvěře"@cs ;
  skos:definition "Minimální stav zvěře je nejnižší povolený počet jedinců určitého druhu zvěře, na který může být stav snížen."@cs ;
  dcterms:description "Minimální stav zvěře určuje, kolik jedinců určitého druhu zvěře musí zůstat po snížení stavu. Tento stav je stanoven orgánem státní správy myslivosti, pokud nelze škody způsobené zvěří snížit jinými způsoby."@cs ;
  rdfs:domain :Snížení-stavu-zvěře ;
  rdfs:range xsd:integer .

:účel-povolení-lovu a owl:DatatypeProperty ;
  rdfs:label "účel povolení lovu"@cs ;
  skos:prefLabel "účel povolení lovu"@cs ;
  skos:definition "Účel povolení lovu mimo dobu lovu je stanoven pro vědecké účely."@cs ;
  dcterms:description "Povolení lovu mimo dobu lovu je udělováno především pro vědecké účely, což znamená, že lov je prováděn za účelem výzkumu a studia zvěře."@cs ;
  rdfs:domain :Povolení-lovu-mimo-dobu-lovu ;
  rdfs:range xsd:string .

:způsob-lovu a owl:DatatypeProperty ;
  rdfs:label "způsob lovu"@cs ;
  skos:prefLabel "způsob lovu"@cs ;
  skos:definition "Způsob lovu může být stanoven v povolení, pokud nedojde k dohodě mezi žadatelem a uživatelem honitby."@cs ;
  dcterms:description "Pokud se žadatel a uživatel honitby nedohodnou na způsobu lovu, může orgán státní správy myslivosti rozhodnout o konkrétním způsobu, jakým bude lov proveden."@cs ;
  rdfs:domain :Povolení-lovu-mimo-dobu-lovu ;
  rdfs:range xsd:string .

:náhrady-za-lov a owl:DatatypeProperty ;
  rdfs:label "náhrady za lov"@cs ;
  skos:prefLabel "náhrady za lov"@cs ;
  skos:definition "Náhrady za lov mohou být stanoveny v povolení, pokud nedojde k dohodě mezi žadatelem a uživatelem honitby."@cs ;
  dcterms:description "V případě, že se žadatel a uživatel honitby nedohodnou na náhradách spojených s lovem, může orgán státní správy myslivosti rozhodnout o výši a způsobu náhrad."@cs ;
  rdfs:domain :Povolení-lovu-mimo-dobu-lovu ;
  rdfs:range xsd:string .

:povolení-lovu a owl:DatatypeProperty ;
  rdfs:label "povolení lovu"@cs ;
  skos:prefLabel "povolení lovu"@cs ;
  skos:definition "Povolení lovu je oprávnění udělené orgánem státní správy myslivosti k provedení lovu zvěře na nehonebních pozemcích."@cs ;
  dcterms:description "Povolení lovu je nezbytné pro legální provádění lovu zvěře na nehonebních pozemcích. Orgán státní správy myslivosti může povolit lov na žádost vlastníků nebo nájemců pozemků, nebo z vlastního podnětu. Povolení může zahrnovat specifické podmínky, jako je denní doba lovu nebo omezení vstupu na určité pozemky."@cs ;
  rdfs:domain :Lov-zvěře ;
  rdfs:range xsd:boolean .

:denní-doba-lovu a owl:DatatypeProperty ;
  rdfs:label "denní doba lovu"@cs ;
  skos:prefLabel "denní doba lovu"@cs ;
  skos:definition "Denní doba lovu je časový úsek stanovený orgánem státní správy myslivosti, během kterého je povoleno provádět lov zvěře."@cs ;
  dcterms:description "Denní doba lovu určuje, kdy je možné legálně lovit zvěř. Může být specifikována v povolení k lovu a může se lišit v závislosti na konkrétních podmínkách a lokalitě."@cs ;
  rdfs:domain :Lov-zvěře ;
  rdfs:range xsd:string .

:zásady-lovu a owl:DatatypeProperty ;
  rdfs:label "zásady lovu"@cs ;
  skos:prefLabel "zásady lovu"@cs ;
  skos:definition "Zásady lovu jsou pravidla a postupy, které musí být dodržovány při provádění lovu zvěře."@cs ;
  dcterms:description "Zásady lovu zahrnují dodržování mysliveckých zásad, zásad ochrany přírody a zásad ochrany zvířat proti týrání. Tyto zásady jsou důležité pro zajištění etického a udržitelného lovu."@cs ;
  rdfs:domain :Lov-zvěře ;
  rdfs:range xsd:string .

:druh-živočichů-k-usmrcení a owl:DatatypeProperty ;
  rdfs:label "druh živočichů k usmrcení"@cs ;
  skos:prefLabel "druh živočichů k usmrcení"@cs ;
  skos:definition "Druh živočichů, jejichž usmrcení je povoleno orgánem státní správy myslivosti na nehonebních pozemcích."@cs ;
  dcterms:description "Určuje konkrétní druhy živočichů, které mohou být usmrceny na základě povolení. Toto povolení je vydáváno za účelem regulace jejich počtu na nehonebních pozemcích."@cs ;
  rdfs:domain :Usmrcování-jiných-živočichů ;
  rdfs:range xsd:string .

:podmínky-usmrcení a owl:DatatypeProperty ;
  rdfs:label "podmínky usmrcení"@cs ;
  skos:prefLabel "podmínky usmrcení"@cs ;
  skos:definition "Podmínky stanovené orgánem státní správy myslivosti pro provedení usmrcení jiných živočichů na nehonebních pozemcích."@cs ;
  dcterms:description "Zahrnuje specifikace jako denní dobu, zásady koordinace postupu osob nebo omezení vstupu na určité pozemky, které musí být dodrženy při usmrcování živočichů."@cs ;
  rdfs:domain :Usmrcování-jiných-živočichů ;
  rdfs:range xsd:string .

:časové-období-lovu a owl:DatatypeProperty ;
  rdfs:label "časové období lovu"@cs ;
  skos:prefLabel "časové období lovu"@cs ;
  skos:definition "Časové období lovu je doba, ve které je povoleno lovit jednotlivé druhy zvěře."@cs ;
  dcterms:description "Časové období lovu určuje konkrétní časové úseky, kdy je legální lovit určité druhy zvěře. Tato období jsou stanovena vyhláškou a mimo ně je lov zakázán."@cs ;
  rdfs:domain :Doba-lovu ;
  rdfs:range xsd:string .

:použití-loveckého-psa a owl:DatatypeProperty ;
  rdfs:label "použití loveckého psa"@cs ;
  skos:prefLabel "použití loveckého psa"@cs ;
  skos:definition "Použití loveckého psa je oprávnění uživatele honitby při sledování a dohledání zvěře postřelené nebo jiným způsobem poraněné."@cs ;
  dcterms:description "Uživatel honitby může při dohledávce zvěře využít loveckého psa, což je povoleno pro efektivnější sledování a dohledání poraněné zvěře."@cs ;
  rdfs:domain :Dohledávka-zvěře ;
  rdfs:range xsd:boolean .

:vstup-na-cizí-pozemky a owl:DatatypeProperty ;
  rdfs:label "vstup na cizí pozemky"@cs ;
  skos:prefLabel "vstup na cizí pozemky"@cs ;
  skos:definition "Vstup na cizí pozemky je oprávnění osob provádějících dohledávku zvěře v nezbytně nutné míře."@cs ;
  dcterms:description "Osoby provádějící dohledávku zvěře mohou vstupovat na cizí honitby a neoplocené nehonební pozemky s loveckou zbraní a psem, pokud předem informují vlastníka nebo nájemce pozemku."@cs ;
  rdfs:domain :Dohledávka-zvěře ;
  rdfs:range xsd:boolean .

:souhlas-vlastníka-oploceného-nehonebního-pozemku a owl:DatatypeProperty ;
  rdfs:label "souhlas vlastníka oploceného nehonebního pozemku"@cs ;
  skos:prefLabel "souhlas vlastníka oploceného nehonebního pozemku"@cs ;
  skos:definition "Souhlas vlastníka oploceného nehonebního pozemku je podmínka pro provedení dohledávky na tomto pozemku."@cs ;
  dcterms:description "Dohledávku na oploceném nehonebním pozemku lze provést pouze se souhlasem jeho vlastníka nebo nájemce."@cs ;
  rdfs:domain :Dohledávka-zvěře ;
  rdfs:range xsd:boolean .

:plemeno-loveckého-psa a owl:DatatypeProperty ;
  rdfs:label "plemeno loveckého psa"@cs ;
  skos:prefLabel "plemeno loveckého psa"@cs ;
  skos:definition "Plemeno loveckého psa musí být uznáno Mezinárodní kynologickou federací (FCI)."@cs ;
  dcterms:description "Plemeno loveckého psa je oficiálně uznáno FCI, což je mezinárodní organizace pro kynologii. Toto uznání je důležité pro zařazení psa mezi lovecké psy."@cs ;
  rdfs:domain :Lovecký-pes ;
  rdfs:range xsd:string .

:průkaz-původu-loveckého-psa a owl:DatatypeProperty ;
  rdfs:label "průkaz původu loveckého psa"@cs ;
  skos:prefLabel "průkaz původu loveckého psa"@cs ;
  skos:definition "Průkaz původu loveckého psa je dokument, který potvrzuje jeho rodokmen a plemennou příslušnost."@cs ;
  dcterms:description "Průkaz původu je důležitý dokument, který dokládá genealogii psa a jeho příslušnost k uznanému plemeni. Je nezbytný pro účast na zkouškách z výkonu."@cs ;
  rdfs:domain :Lovecký-pes ;
  rdfs:range xsd:string .

:zkouška-z-výkonu-loveckého-psa a owl:DatatypeProperty ;
  rdfs:label "zkouška z výkonu loveckého psa"@cs ;
  skos:prefLabel "zkouška z výkonu loveckého psa"@cs ;
  skos:definition "Zkouška z výkonu loveckého psa je test, který pes musí úspěšně složit, aby byl považován za loveckého psa."@cs ;
  dcterms:description "Zkouška z výkonu ověřuje schopnosti a dovednosti psa v loveckých aktivitách. Úspěšné složení této zkoušky je podmínkou pro uznání psa jako loveckého."@cs ;
  rdfs:domain :Lovecký-pes ;
  rdfs:range xsd:boolean .

:povolení-k-použití-loveckého-dravce a owl:DatatypeProperty ;
  rdfs:label "povolení k použití loveckého dravce"@cs ;
  skos:prefLabel "povolení k použití loveckého dravce"@cs ;
  skos:definition "Povolení k použití loveckého dravce v sokolnictví vydané orgánem státní správy myslivosti."@cs ;
  dcterms:description "Toto povolení je nezbytné pro legální použití loveckého dravce v sokolnictví. Orgán státní správy myslivosti je zodpovědný za jeho vydání."@cs ;
  rdfs:domain :Lovecký-dravec ;
  rdfs:range xsd:boolean .

:povolení-k-držení-a-chovu-loveckého-dravce a owl:DatatypeProperty ;
  rdfs:label "povolení k držení a chovu loveckého dravce"@cs ;
  skos:prefLabel "povolení k držení a chovu loveckého dravce"@cs ;
  skos:definition "Povolení k držení a chovu loveckého dravce podle předpisů o ochraně přírody."@cs ;
  dcterms:description "Držení a chov loveckého dravce je možné pouze s platným povolením, které je vydáno v souladu s předpisy o ochraně přírody."@cs ;
  rdfs:domain :Lovecký-dravec ;
  rdfs:range xsd:boolean .

:členství-v-sokolnické-organizaci a owl:DatatypeProperty ;
  rdfs:label "členství v sokolnické organizaci"@cs ;
  skos:prefLabel "členství v sokolnické organizaci"@cs ;
  skos:definition "Členství držitele loveckého dravce v sokolnické organizaci."@cs ;
  dcterms:description "Držitel loveckého dravce musí být členem sokolnické organizace, což je podmínka pro legální chov a použití dravce."@cs ;
  rdfs:domain :Lovecký-dravec ;
  rdfs:range xsd:boolean .

:složení-sokolnických-zkoušek a owl:DatatypeProperty ;
  rdfs:label "složení sokolnických zkoušek"@cs ;
  skos:prefLabel "složení sokolnických zkoušek"@cs ;
  skos:definition "Složení sokolnických zkoušek držitelem loveckého dravce."@cs ;
  dcterms:description "Držitel loveckého dravce musí úspěšně složit sokolnické zkoušky, což je podmínka pro legální chov a použití dravce."@cs ;
  rdfs:domain :Lovecký-dravec ;
  rdfs:range xsd:boolean .

:soulad-se-zásadami-mysliveckými a owl:DatatypeProperty ;
  rdfs:label "soulad se zásadami mysliveckými"@cs ;
  skos:prefLabel "soulad se zásadami mysliveckými"@cs ;
  skos:definition "Soulad se zásadami mysliveckými znamená, že způsob lovu musí odpovídat pravidlům a tradicím myslivosti."@cs ;
  dcterms:description "Způsob lovu musí být v souladu s mysliveckými zásadami, které zahrnují etické a tradiční postupy při lovu zvěře."@cs ;
  rdfs:domain :Způsob-lovu ;
  rdfs:range xsd:boolean .

:soulad-se-zásadami-ochrany-přírody a owl:DatatypeProperty ;
  rdfs:label "soulad se zásadami ochrany přírody"@cs ;
  skos:prefLabel "soulad se zásadami ochrany přírody"@cs ;
  skos:definition "Soulad se zásadami ochrany přírody znamená, že způsob lovu nesmí poškozovat přírodní prostředí."@cs ;
  dcterms:description "Způsob lovu musí respektovat zásady ochrany přírody, což zahrnuje minimalizaci negativních dopadů na ekosystémy a přírodní zdroje."@cs ;
  rdfs:domain :Způsob-lovu ;
  rdfs:range xsd:boolean .

:soulad-se-zásadami-ochrany-zvířat-proti-týrání a owl:DatatypeProperty ;
  rdfs:label "soulad se zásadami ochrany zvířat proti týrání"@cs ;
  skos:prefLabel "soulad se zásadami ochrany zvířat proti týrání"@cs ;
  skos:definition "Soulad se zásadami ochrany zvířat proti týrání znamená, že způsob lovu nesmí způsobovat zbytečné utrpení zvířat."@cs ;
  dcterms:description "Způsob lovu musí být prováděn tak, aby nedocházelo k týrání zvířat, což zahrnuje zákaz používání krutých metod a zařízení."@cs ;
  rdfs:domain :Způsob-lovu ;
  rdfs:range xsd:boolean .

:zakázané-metody-lovu a owl:DatatypeProperty ;
  rdfs:label "zakázané metody lovu"@cs ;
  skos:prefLabel "zakázané metody lovu"@cs ;
  skos:definition "Zakázané metody lovu jsou konkrétní techniky a nástroje, které jsou zákonem zakázány při lovu zvěře."@cs ;
  dcterms:description "Mezi zakázané metody patří například chytání zvěře do pastí, používání jedů, lov s pomocí elektrických zařízení, lov v noci bez vhodné optiky a další praktiky, které mohou způsobit zbytečné utrpení zvířat nebo poškození přírody."@cs ;
  rdfs:domain :Zakázané-způsoby-lovu ;
  rdfs:range xsd:string .

:povolení-k-úpravě-stavu-zvěře a owl:DatatypeProperty ;
  rdfs:label "povolení k úpravě stavu zvěře"@cs ;
  skos:prefLabel "povolení k úpravě stavu zvěře"@cs ;
  skos:definition "Povolení k úpravě stavu zvěře je rozhodnutí orgánu státní správy myslivosti, které umožňuje změny v počtu zvěře v honitbě."@cs ;
  dcterms:description "Toto povolení může zahrnovat lov určitých druhů zvěře nebo zrušení chovu, a to i s výjimkami z některých zakázaných způsobů lovu, pokud je to nezbytné pro řízení populace zvěře."@cs ;
  rdfs:domain :Úprava-stavu-zvěře ;
  rdfs:range xsd:boolean .

:platnost-povolenky-k-lovu a owl:DatatypeProperty ;
  rdfs:label "platnost povolenky k lovu"@cs ;
  skos:prefLabel "platnost povolenky k lovu"@cs ;
  skos:definition "Platnost povolenky k lovu je časové období, po které je povolenka k lovu platná."@cs ;
  dcterms:description "Platnost povolenky k lovu určuje, jak dlouho může osoba legálně lovit zvěř nebo usmrcovat jiného živočicha na základě této povolenky. Po uplynutí této doby je nutné získat novou povolenku."@cs ;
  rdfs:domain :Povolenka-k-lovu ;
  rdfs:range xsd:date .

:evidence-vydaných-povolenek-k-lovu a owl:DatatypeProperty ;
  rdfs:label "evidence vydaných povolenek k lovu"@cs ;
  skos:prefLabel "evidence vydaných povolenek k lovu"@cs ;
  skos:definition "Evidence vydaných povolenek k lovu je záznam o všech povolenkách, které byly vydány uživatelem honitby."@cs ;
  dcterms:description "Uživatel honitby je povinen vést a archivovat evidenci vydaných povolenek k lovu, včetně jejich vzorů, po dobu nejméně 3 let od skončení jejich platnosti. Tato evidence slouží k zajištění přehledu o vydaných povolenkách a jejich platnosti."@cs ;
  rdfs:domain :Povolenka-k-lovu ;
  rdfs:range xsd:string .

:seznam-účastníků a owl:DatatypeProperty ;
  rdfs:label "seznam účastníků"@cs ;
  skos:prefLabel "seznam účastníků"@cs ;
  skos:definition "Seznam osob, které se účastní společného lovu a který může nahradit individuální povolenky k lovu."@cs ;
  dcterms:description "Seznam účastníků slouží jako hromadná povolenka k lovu, což znamená, že jednotliví účastníci nemusí mít individuální povolenky. Tento seznam je důležitý pro organizaci a kontrolu společného lovu."@cs ;
  rdfs:domain :Hromadná-povolenka-k-lovu ;
  rdfs:range xsd:string .

:druh-loveckého-lístku a owl:DatatypeProperty ;
  rdfs:label "druh loveckého lístku"@cs ;
  skos:prefLabel "druh loveckého lístku"@cs ;
  skos:definition "Druh loveckého lístku určuje, pro koho je lovecký lístek vydán."@cs ;
  dcterms:description "Existují různé druhy loveckých lístků, například pro české občany, pro žáky a posluchače odborných škol, kde je myslivost studijním oborem, a pro cizince."@cs ;
  rdfs:domain :Lovecký-lístek ;
  rdfs:range xsd:string .

:věk-žadatele-o-lovecký-lístek a owl:DatatypeProperty ;
  rdfs:label "věk žadatele o lovecký lístek"@cs ;
  skos:prefLabel "věk žadatele o lovecký lístek"@cs ;
  skos:definition "Věk žadatele o lovecký lístek musí být alespoň 16 let."@cs ;
  dcterms:description "Žadatel o lovecký lístek musí být starší 16 let, což je minimální věková hranice pro vydání loveckého lístku."@cs ;
  rdfs:domain :Lovecký-lístek ;
  rdfs:range xsd:integer .

:právní-způsobilost-žadatele-o-lovecký-lístek a owl:DatatypeProperty ;
  rdfs:label "právní způsobilost žadatele o lovecký lístek"@cs ;
  skos:prefLabel "právní způsobilost žadatele o lovecký lístek"@cs ;
  skos:definition "Právní způsobilost žadatele o lovecký lístek je podmínkou pro jeho vydání."@cs ;
  dcterms:description "Žadatel musí mít způsobilost k právním úkonům, což znamená, že je schopen právně jednat a uzavírat právní úkony."@cs ;
  rdfs:domain :Lovecký-lístek ;
  rdfs:range xsd:boolean .

:pojištění-žadatele-o-lovecký-lístek a owl:DatatypeProperty ;
  rdfs:label "pojištění žadatele o lovecký lístek"@cs ;
  skos:prefLabel "pojištění žadatele o lovecký lístek"@cs ;
  skos:definition "Pojištění žadatele o lovecký lístek je jednou z podmínek pro jeho vydání."@cs ;
  dcterms:description "Žadatel musí být pojištěn, což je nezbytné pro krytí případných škod způsobených při výkonu myslivosti."@cs ;
  rdfs:domain :Lovecký-lístek ;
  rdfs:range xsd:boolean .

:věk-žadatele a owl:DatatypeProperty ;
  rdfs:label "věk žadatele"@cs ;
  skos:prefLabel "věk žadatele"@cs ;
  skos:definition "Věk žadatele o lovecký lístek musí být nejméně 16 let."@cs ;
  dcterms:description "Žadatel o lovecký lístek musí být starší 16 let, což je minimální věková hranice pro podání žádosti."@cs ;
  rdfs:domain :Žadatel-o-lovecký-lístek ;
  rdfs:range xsd:integer .

:právní-způsobilost-žadatele a owl:DatatypeProperty ;
  rdfs:label "právní způsobilost žadatele"@cs ;
  skos:prefLabel "právní způsobilost žadatele"@cs ;
  skos:definition "Právní způsobilost žadatele o lovecký lístek je podmínkou pro jeho vydání."@cs ;
  dcterms:description "Žadatel musí mít způsobilost k právním úkonům, což znamená, že je schopen právně jednat a uzavírat právní úkony."@cs ;
  rdfs:domain :Žadatel-o-lovecký-lístek ;
  rdfs:range xsd:boolean .

:bezúhonnost-žadatele a owl:DatatypeProperty ;
  rdfs:label "bezúhonnost žadatele"@cs ;
  skos:prefLabel "bezúhonnost žadatele"@cs ;
  skos:definition "Bezúhonnost žadatele o lovecký lístek je stav, kdy žadatel nebyl pravomocně odsouzen pro úmyslný trestný čin nebo uznán vinným ze spáchání přestupku na úseku myslivosti."@cs ;
  dcterms:description "Pro splnění podmínky bezúhonnosti je třeba předložit výpis z Rejstříku trestů a čestné prohlášení o neuložení správních trestů za přestupky na úseku myslivosti."@cs ;
  rdfs:domain :Žadatel-o-lovecký-lístek ;
  rdfs:range xsd:boolean .

:pojištění-žadatele a owl:DatatypeProperty ;
  rdfs:label "pojištění žadatele"@cs ;
  skos:prefLabel "pojištění žadatele"@cs ;
  skos:definition "Pojištění žadatele o lovecký lístek je podmínkou pro jeho vydání."@cs ;
  dcterms:description "Žadatel musí být pojištěn, což je jedna z podmínek pro získání loveckého lístku."@cs ;
  rdfs:domain :Žadatel-o-lovecký-lístek ;
  rdfs:range xsd:boolean .

:limit-pojistného-plnění-za-škodu-na-zdraví-nebo-usmrcení a owl:DatatypeProperty ;
  rdfs:label "limit pojistného plnění za škodu na zdraví nebo usmrcení"@cs ;
  skos:prefLabel "limit pojistného plnění za škodu na zdraví nebo usmrcení"@cs ;
  skos:definition "Limit pojistného plnění za škodu způsobenou ublížením na zdraví nebo usmrcením jiných osob při lovu zvěře musí být nejméně ve výši 20 000 000 Kč."@cs ;
  dcterms:description "Tento limit určuje minimální částku, kterou pojišťovna vyplatí v případě škody na zdraví nebo usmrcení způsobené při lovu zvěře. Je stanoven zákonem a musí být dodržen při sjednávání povinného pojištění."@cs ;
  rdfs:domain :Povinné-pojištění ;
  rdfs:range xsd:integer .

:limit-pojistného-plnění-za-škodu-na-věci a owl:DatatypeProperty ;
  rdfs:label "limit pojistného plnění za škodu na věci"@cs ;
  skos:prefLabel "limit pojistného plnění za škodu na věci"@cs ;
  skos:definition "Limit pojistného plnění za škodu na věci způsobenou při lovu zvěře musí být nejméně ve výši 500 000 Kč na jednu pojistnou událost."@cs ;
  dcterms:description "Tento limit určuje minimální částku, kterou pojišťovna vyplatí v případě škody na majetku způsobené při lovu zvěře. Je stanoven zákonem a musí být dodržen při sjednávání povinného pojištění."@cs ;
  rdfs:domain :Povinné-pojištění ;
  rdfs:range xsd:integer .

:zaplacení-členského-příspěvku a owl:DatatypeProperty ;
  rdfs:label "zaplacení členského příspěvku"@cs ;
  skos:prefLabel "zaplacení členského příspěvku"@cs ;
  skos:definition "Zaplacení členského příspěvku je potvrzeno v členském průkazu myslivecké organizace a je podmínkou pro platnost povinného pojištění."@cs ;
  dcterms:description "Členský průkaz myslivecké organizace obsahuje potvrzení o zaplacení členského příspěvku na běžný rok, což je důkazem o splnění povinnosti platit členské příspěvky a zároveň podmínkou pro platnost povinného pojištění."@cs ;
  rdfs:domain :Členský-průkaz-myslivecké-organizace ;
  rdfs:range xsd:boolean .

:poznámka-o-povinném-pojištění a owl:DatatypeProperty ;
  rdfs:label "poznámka o povinném pojištění"@cs ;
  skos:prefLabel "poznámka o povinném pojištění"@cs ;
  skos:definition "Poznámka v členském průkazu myslivecké organizace, která uvádí, že v členském příspěvku je zahrnuto povinné pojištění podle zákona."@cs ;
  dcterms:description "Členský průkaz může obsahovat poznámku, že povinné pojištění je zahrnuto v členském příspěvku, což slouží jako důkaz o platnosti pojištění pro členy mysliveckých organizací."@cs ;
  rdfs:domain :Členský-průkaz-myslivecké-organizace ;
  rdfs:range xsd:string .

:označení-plomby a owl:DatatypeProperty ;
  rdfs:label "označení plomby"@cs ;
  skos:prefLabel "označení plomby"@cs ;
  skos:definition "Označení plomby je nesnímatelná značka, kterou musí být označen každý kus ulovené nebo nalezené zužitkovatelné zvěře spárkaté."@cs ;
  dcterms:description "Označení plomby slouží k identifikaci a evidenci ulovené nebo nalezené zvěře spárkaté. Plomba je nesnímatelná a zajišťuje sledovatelnost zvěře."@cs ;
  rdfs:domain :Zvěř-spárkatá ;
  rdfs:range xsd:string .

:druh-plomby a owl:DatatypeProperty ;
  rdfs:label "druh plomby"@cs ;
  skos:prefLabel "druh plomby"@cs ;
  skos:definition "Druh plomby určuje specifický typ nesnímatelné značky používané k označení ulovené nebo nalezené zvěře spárkaté."@cs ;
  dcterms:description "Druhy plomb mohou být různé a jsou stanoveny vyhláškou. Každý druh plomby může mít specifické vlastnosti a použití v závislosti na druhu zvěře nebo způsobu lovu."@cs ;
  rdfs:domain :Plomba ;
  rdfs:range xsd:string .

:způsob-výdeje-plomby a owl:DatatypeProperty ;
  rdfs:label "způsob výdeje plomby"@cs ;
  skos:prefLabel "způsob výdeje plomby"@cs ;
  skos:definition "Způsob výdeje plomby určuje, jakým způsobem jsou plomby distribuovány uživatelům honiteb."@cs ;
  dcterms:description "Výdej plomb je regulován a může zahrnovat různé postupy, jako je osobní vyzvednutí, zaslání poštou nebo elektronická registrace. Správný způsob výdeje zajišťuje, že plomby jsou dostupné včas a v potřebném množství."@cs ;
  rdfs:domain :Plomba ;
  rdfs:range xsd:string .

:způsob-evidence-plomby a owl:DatatypeProperty ;
  rdfs:label "způsob evidence plomby"@cs ;
  skos:prefLabel "způsob evidence plomby"@cs ;
  skos:definition "Způsob evidence plomby určuje, jakým způsobem jsou plomby zaznamenávány a sledovány."@cs ;
  dcterms:description "Evidence plomb je důležitá pro zajištění sledovatelnosti a správné správy ulovené zvěře. Může zahrnovat elektronické systémy, papírové záznamy nebo kombinaci obou."@cs ;
  rdfs:domain :Plomba ;
  rdfs:range xsd:string .

:způsob-připevňování-plomby a owl:DatatypeProperty ;
  rdfs:label "způsob připevňování plomby"@cs ;
  skos:prefLabel "způsob připevňování plomby"@cs ;
  skos:definition "Způsob připevňování plomby určuje, jakým způsobem je plomba fyzicky připevněna na ulovenou nebo nalezenou zvěř spárkatou."@cs ;
  dcterms:description "Připevňování plomby musí být provedeno tak, aby byla plomba nesnímatelná a zajišťovala identifikaci zvěře. Může zahrnovat použití speciálních nástrojů nebo technik."@cs ;
  rdfs:domain :Plomba ;
  rdfs:range xsd:string .

:způsob-snímání-plomby a owl:DatatypeProperty ;
  rdfs:label "způsob snímání plomby"@cs ;
  skos:prefLabel "způsob snímání plomby"@cs ;
  skos:definition "Způsob snímání plomby určuje, jakým způsobem může být plomba odstraněna z ulovené nebo nalezené zvěře spárkaté."@cs ;
  dcterms:description "Snímání plomby je regulováno, aby bylo zajištěno, že plomba je odstraněna pouze oprávněnými osobami a v souladu s předpisy. Může zahrnovat specifické postupy nebo nástroje."@cs ;
  rdfs:domain :Plomba ;
  rdfs:range xsd:string .

:datum-ulovení a owl:DatatypeProperty ;
  rdfs:label "datum ulovení"@cs ;
  skos:prefLabel "datum ulovení"@cs ;
  skos:definition "Datum ulovení zvěře, které musí být uvedeno na lístku o původu zvěře."@cs ;
  dcterms:description "Datum ulovení je důležitou informací pro sledování a evidenci ulovené zvěře. Pomáhá určit, kdy byla zvěř ulovena, což je klíčové pro dodržování lovných období a dalších předpisů."@cs ;
  rdfs:domain :Lístek-o-původu-zvěře ;
  rdfs:range xsd:date .

:honitba a owl:DatatypeProperty ;
  rdfs:label "honitba"@cs ;
  skos:prefLabel "honitba"@cs ;
  skos:definition "Honitba, ve které byl kus zvěře uloven, musí být uvedena na lístku o původu zvěře."@cs ;
  dcterms:description "Honitba je specifická oblast, kde byl kus zvěře uloven. Tato informace je důležitá pro sledování původu zvěře a pro zajištění, že lov probíhá v souladu s místními pravidly a předpisy."@cs ;
  rdfs:domain :Lístek-o-původu-zvěře ;
  rdfs:range xsd:string .

:číslo-plomby a owl:DatatypeProperty ;
  rdfs:label "číslo plomby"@cs ;
  skos:prefLabel "číslo plomby"@cs ;
  skos:definition "Číslo plomby, které je přiděleno ulovené zvěři, musí být uvedeno na lístku o původu zvěře."@cs ;
  dcterms:description "Číslo plomby slouží k jednoznačné identifikaci ulovené zvěře. Pomáhá zajistit sledovatelnost a správnou evidenci zvěře od místa ulovení až po konečného příjemce."@cs ;
  rdfs:domain :Lístek-o-původu-zvěře ;
  rdfs:range xsd:string .

:místo-způsobení-škody a owl:DatatypeProperty ;
  rdfs:label "místo způsobení škody"@cs ;
  skos:prefLabel "místo způsobení škody"@cs ;
  skos:definition "Místo, kde byla škoda způsobena, může být honební pozemek, polní plodina dosud nesklizená, vinná réva, ovocná kultura nebo lesní porost."@cs ;
  dcterms:description "Místo způsobení škody určuje, na jakém typu pozemku nebo plodině byla škoda způsobena. To může zahrnovat různé typy zemědělských a lesních ploch, které jsou součástí honitby."@cs ;
  rdfs:domain :Škoda ;
  rdfs:range xsd:string .

:způsobení-škody a owl:DatatypeProperty ;
  rdfs:label "způsobení škody"@cs ;
  skos:prefLabel "způsobení škody"@cs ;
  skos:definition "Způsobení škody může být výsledkem provozování myslivosti nebo činností zvěře v honitbě."@cs ;
  dcterms:description "Způsobení škody se týká toho, jakým způsobem byla škoda způsobena, a to buď lidskou činností při myslivosti, nebo přirozeným chováním zvěře."@cs ;
  rdfs:domain :Škoda ;
  rdfs:range xsd:string .

:odpovědnost-za-škody-způsobené-zvěří a owl:DatatypeProperty ;
  rdfs:label "odpovědnost za škody způsobené zvěří"@cs ;
  skos:prefLabel "odpovědnost za škody způsobené zvěří"@cs ;
  skos:definition "Odpovědnost uživatele obory za škody způsobené zvěří, která unikla z obory."@cs ;
  dcterms:description "Uživatel obory je povinen hradit škody způsobené zvěří, která unikla z obory, pokud neprokáže, že uniknutí bylo způsobeno neodvratitelnou událostí nebo osobou, za niž neodpovídá."@cs ;
  rdfs:domain :Uživatel-obory ;
  rdfs:range xsd:boolean .

:pozemek-škody a owl:DatatypeProperty ;
  rdfs:label "pozemek škody"@cs ;
  skos:prefLabel "pozemek škody"@cs ;
  skos:definition "Pozemek, na kterém byla způsobena škoda zvěří."@cs ;
  dcterms:description "Určuje, zda se škoda stala na honebním nebo nehonebním pozemku. Škody na nehonebních pozemcích nejsou hrazeny."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:string .

:ošetření-vinné-révy a owl:DatatypeProperty ;
  rdfs:label "ošetření vinné révy"@cs ;
  skos:prefLabel "ošetření vinné révy"@cs ;
  skos:definition "Ošetření vinné révy proti škodám způsobeným zvěří."@cs ;
  dcterms:description "Pokud vinná réva není ošetřena proti škodám způsobeným zvěří, škody na ní nejsou hrazeny."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:boolean .

:oplocení-květinové-školky-nebo-zahrady a owl:DatatypeProperty ;
  rdfs:label "oplocení květinové školky nebo zahrady"@cs ;
  skos:prefLabel "oplocení květinové školky nebo zahrady"@cs ;
  skos:definition "Oplocení květinové školky nebo zahrady ovocné a zelinářské proti škodám způsobeným zvěří."@cs ;
  dcterms:description "Pokud květinová školka nebo zahrada není oplocena, škody způsobené zvěří nejsou hrazeny."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:boolean .

:agrotechnická-lhůta-sklizně a owl:DatatypeProperty ;
  rdfs:label "agrotechnická lhůta sklizně"@cs ;
  skos:prefLabel "agrotechnická lhůta sklizně"@cs ;
  skos:definition "Lhůta, ve které by měly být zemědělské plodiny sklizeny podle agrotechnických pravidel."@cs ;
  dcterms:description "Pokud zemědělské plodiny nejsou sklizeny v agrotechnických lhůtách, škody způsobené zvěří na těchto plodinách nejsou hrazeny."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:boolean .

:opatření-ochrany-plodin a owl:DatatypeProperty ;
  rdfs:label "opatření ochrany plodin"@cs ;
  skos:prefLabel "opatření ochrany plodin"@cs ;
  skos:definition "Opatření provedená za účelem účinné ochrany zemědělských plodin uskladněných na honebních pozemcích proti škodám způsobeným zvěří."@cs ;
  dcterms:description "Pokud nejsou provedena účinná opatření na ochranu uskladněných plodin, škody způsobené zvěří nejsou hrazeny."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:boolean .

:početní-stavy-zvěře a owl:DatatypeProperty ;
  rdfs:label "početní stavy zvěře"@cs ;
  skos:prefLabel "početní stavy zvěře"@cs ;
  skos:definition "Početní stavy zvěře, které nemohou být lovem snižovány."@cs ;
  dcterms:description "Pokud početní stavy zvěře nemohou být lovem snižovány, škody způsobené touto zvěří hradí stát."@cs ;
  rdfs:domain :Škoda-způsobená-zvěří ;
  rdfs:range xsd:boolean .

:rozhodnutí-o-vysokocennosti-plodiny a owl:DatatypeProperty ;
  rdfs:label "rozhodnutí o vysokocennosti plodiny"@cs ;
  skos:prefLabel "rozhodnutí o vysokocennosti plodiny"@cs ;
  skos:definition "Rozhodnutí o tom, zda je plodina považována za vysokocennou, provádí orgán státní správy myslivosti v případě pochybností."@cs ;
  dcterms:description "Toto rozhodnutí určuje, zda je plodina považována za vysokocennou a tedy, zda se na ni vztahují specifická pravidla ohledně náhrady škod způsobených zvěří. Orgán státní správy myslivosti má pravomoc rozhodnout v případech, kdy existují pochybnosti o hodnotě plodiny."@cs ;
  rdfs:domain :Vysokocenná-plodina ;
  rdfs:range xsd:boolean .

:lhůta-pro-uplatnění-nároku-na-náhradu-škody a owl:DatatypeProperty ;
  rdfs:label "lhůta pro uplatnění nároku na náhradu škody"@cs ;
  skos:prefLabel "lhůta pro uplatnění nároku na náhradu škody"@cs ;
  skos:definition "Lhůta, ve které musí poškozený uplatnit nárok na náhradu škody způsobené zvěří u uživatele honitby."@cs ;
  dcterms:description "Lhůta se liší podle typu škody. U škody na zemědělských pozemcích, polních plodinách a zemědělských porostech je to do 20 dnů ode dne, kdy škoda vznikla. U škod na lesních pozemcích a lesních porostech vzniklých v období od 1. července předcházejícího roku do 30. června běžného roku je to do 20 dnů od uplynutí uvedeného období."@cs ;
  rdfs:domain :Nárok-na-náhradu-škody-způsobené-zvěří ;
  rdfs:range xsd:integer .

:výše-škody a owl:DatatypeProperty ;
  rdfs:label "výše škody"@cs ;
  skos:prefLabel "výše škody"@cs ;
  skos:definition "Vyčíslená výše škody způsobené zvěří, kterou poškozený uvádí při uplatnění nároku na náhradu škody."@cs ;
  dcterms:description "Poškozený musí vyčíslit výši škody současně s uplatněním nároku. U polních plodin a zemědělských porostů, kde lze škodu vyčíslit teprve v době sklizně, je lhůta pro vyčíslení do 15 dnů po sklizni."@cs ;
  rdfs:domain :Nárok-na-náhradu-škody-způsobené-zvěří ;
  rdfs:range xsd:integer .

:lhůta-pro-dohodu-o-náhradě-škody a owl:DatatypeProperty ;
  rdfs:label "lhůta pro dohodu o náhradě škody"@cs ;
  skos:prefLabel "lhůta pro dohodu o náhradě škody"@cs ;
  skos:definition "Lhůta, ve které se poškozený a uživatel honitby mají dohodnout o náhradě škody způsobené zvěří."@cs ;
  dcterms:description "Pokud uživatel honitby nenahradí škodu do 60 dnů ode dne, kdy poškozený uplatnil svůj nárok a vyčíslil výši škody, nebo ve stejné lhůtě neuzavřel s poškozeným písemnou dohodu o náhradě této škody, může poškozený ve lhůtě 3 měsíců uplatnit svůj nárok na náhradu škody u soudu."@cs ;
  rdfs:domain :Nárok-na-náhradu-škody-způsobené-zvěří ;
  rdfs:range xsd:integer .

:doba-uzavření-dohody a owl:DatatypeProperty ;
  rdfs:label "doba uzavření dohody"@cs ;
  skos:prefLabel "doba uzavření dohody"@cs ;
  skos:definition "Doba, do které musí být uzavřena dohoda o náhradě škody způsobené zvěří mezi poškozeným a uživatelem honitby."@cs ;
  dcterms:description "Dohoda o náhradě škody způsobené zvěří by měla být uzavřena do 60 dnů ode dne, kdy poškozený uplatnil svůj nárok a vyčíslil výši škody. Pokud není dohoda uzavřena v této lhůtě, může poškozený uplatnit svůj nárok u soudu."@cs ;
  rdfs:domain :Dohoda-o-náhradě-škody-způsobené-zvěří ;
  rdfs:range xsd:integer .

:odpovědná-osoba-za-škodu-na-zvěři a owl:DatatypeProperty ;
  rdfs:label "odpovědná osoba za škodu na zvěři"@cs ;
  skos:prefLabel "odpovědná osoba za škodu na zvěři"@cs ;
  skos:definition "Osoba, která odpovídá za škodu na zvěři způsobenou porušením právní povinnosti."@cs ;
  dcterms:description "Každý, kdo poruší právní povinnost a způsobí tím škodu na zvěři, je za tuto škodu odpovědný."@cs ;
  rdfs:domain :Škoda-na-zvěři ;
  rdfs:range xsd:string .

:nárok-na-náhradu-škody-na-zvěři a owl:DatatypeProperty ;
  rdfs:label "nárok na náhradu škody na zvěři"@cs ;
  skos:prefLabel "nárok na náhradu škody na zvěři"@cs ;
  skos:definition "Nárok na náhradu škody na zvěři má uživatel honitby."@cs ;
  dcterms:description "Uživatel honitby má právo požadovat náhradu škody způsobené na zvěři, pokud došlo k porušení právní povinnosti."@cs ;
  rdfs:domain :Škoda-na-zvěři ;
  rdfs:range xsd:string .

:obsah-vyšších-odborných-mysliveckých-zkoušek a owl:DatatypeProperty ;
  rdfs:label "obsah vyšších odborných mysliveckých zkoušek"@cs ;
  skos:prefLabel "obsah vyšších odborných mysliveckých zkoušek"@cs ;
  skos:definition "Obsah vyšších odborných mysliveckých zkoušek zahrnuje ověření znalostí myslivosti a obecně závazných právních předpisů o myslivosti a předpisů souvisejících."@cs ;
  dcterms:description "Obsah zkoušek se zaměřuje na prohloubení znalostí potřebných pro výkon myslivosti v souladu s platnými právními normami. Zkoušky ověřují znalosti v oblasti myslivosti a souvisejících právních předpisů."@cs ;
  rdfs:domain :Vyšší-odborné-myslivecké-zkoušky ;
  rdfs:range xsd:string .

:souhlas-s-chovem-zvěře-v-zajetí a owl:DatatypeProperty ;
  rdfs:label "souhlas s chovem zvěře v zajetí"@cs ;
  skos:prefLabel "souhlas s chovem zvěře v zajetí"@cs ;
  skos:definition "Souhlas s chovem zvěře v zajetí je rozhodnutí kraje v přenesené působnosti podle § 7 odst. 1."@cs ;
  dcterms:description "Kraj může udělit souhlas k chovu zvěře v zajetí, což je důležité pro regulaci a kontrolu chovu zvěře v rámci kraje."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:omezení-obvyklého-způsobu-hospodaření-v-honitbách a owl:DatatypeProperty ;
  rdfs:label "omezení obvyklého způsobu hospodaření v honitbách"@cs ;
  skos:prefLabel "omezení obvyklého způsobu hospodaření v honitbách"@cs ;
  skos:definition "Omezení obvyklého způsobu hospodaření v některých honitbách je rozhodnutí kraje v přenesené působnosti podle § 4 odst. 1."@cs ;
  dcterms:description "Kraj může omezit obvyklý způsob hospodaření v honitbách, což může být nezbytné pro ochranu přírody nebo zvěře."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:vymezení-oblastí-pro-chov-zvěře a owl:DatatypeProperty ;
  rdfs:label "vymezení oblastí pro chov zvěře"@cs ;
  skos:prefLabel "vymezení oblastí pro chov zvěře"@cs ;
  skos:definition "Vymezení oblastí pro chov zvěře je rozhodnutí kraje v přenesené působnosti podle § 3 odst. 3."@cs ;
  dcterms:description "Kraj určuje specifické oblasti, kde je povolen chov zvěře, což pomáhá v řízení a ochraně zvěře."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:prohlášení-dalších-pozemků-za-nehonební a owl:DatatypeProperty ;
  rdfs:label "prohlášení dalších pozemků za nehonební"@cs ;
  skos:prefLabel "prohlášení dalších pozemků za nehonební"@cs ;
  skos:definition "Prohlášení dalších pozemků za nehonební je rozhodnutí kraje v přenesené působnosti podle § 17 odst. 2."@cs ;
  dcterms:description "Kraj může prohlásit určité pozemky za nehonební, což znamená, že na nich nelze vykonávat myslivost."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:povolení-použití-dravců-jako-loveckých a owl:DatatypeProperty ;
  rdfs:label "povolení použití dravců jako loveckých"@cs ;
  skos:prefLabel "povolení použití dravců jako loveckých"@cs ;
  skos:definition "Povolení použití dravců jako loveckých je rozhodnutí kraje v přenesené působnosti podle § 44 odst. 2."@cs ;
  dcterms:description "Kraj může povolit použití dravců pro lovecké účely, což je specifická forma lovu."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:uložení-opatření-k-odstranění-nedostatků a owl:DatatypeProperty ;
  rdfs:label "uložení opatření k odstranění nedostatků"@cs ;
  skos:prefLabel "uložení opatření k odstranění nedostatků"@cs ;
  skos:definition "Uložení opatření k odstranění nedostatků zjištěných při provádění dozoru je rozhodnutí kraje v přenesené působnosti podle § 61 odst. 3."@cs ;
  dcterms:description "Kraj může nařídit opatření k odstranění nedostatků, které byly zjištěny během dozoru, což je důležité pro zajištění dodržování předpisů."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:poskytování-finančních-příspěvků a owl:DatatypeProperty ;
  rdfs:label "poskytování finančních příspěvků"@cs ;
  skos:prefLabel "poskytování finančních příspěvků"@cs ;
  skos:definition "Poskytování finančních příspěvků je rozhodnutí kraje v přenesené působnosti podle § 62 odst. 1."@cs ;
  dcterms:description "Kraj může poskytovat finanční příspěvky, což může podporovat různé aktivity v oblasti myslivosti a ochrany přírody."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:vedení-agendy-oblastí-pro-chov-zvěře a owl:DatatypeProperty ;
  rdfs:label "vedení agendy oblastí pro chov zvěře"@cs ;
  skos:prefLabel "vedení agendy oblastí pro chov zvěře"@cs ;
  skos:definition "Vedení agendy týkající se oblastí pro chov zvěře je činnost kraje v přenesené působnosti podle § 3 odst. 3."@cs ;
  dcterms:description "Kraj vede agendu oblastí pro chov zvěře, což zahrnuje správu a evidenci těchto oblastí."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:organizace-chovatelských-přehlídek a owl:DatatypeProperty ;
  rdfs:label "organizace chovatelských přehlídek"@cs ;
  skos:prefLabel "organizace chovatelských přehlídek"@cs ;
  skos:definition "Organizace chovatelských přehlídek v oblastech pro chov zvěře je činnost kraje v přenesené působnosti podle § 6 odst. 1."@cs ;
  dcterms:description "Kraj organizuje chovatelské přehlídky, které slouží k prezentaci a hodnocení chovu zvěře."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:určení-termínů-sčítání-zvěře a owl:DatatypeProperty ;
  rdfs:label "určení termínů sčítání zvěře"@cs ;
  skos:prefLabel "určení termínů sčítání zvěře"@cs ;
  skos:definition "Určení termínů sčítání zvěře je činnost kraje v přenesené působnosti podle § 36 odst. 1."@cs ;
  dcterms:description "Kraj určuje termíny, kdy se provádí sčítání zvěře, což je důležité pro monitorování populací zvěře."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:zpracování-statistických-hlášení-o-myslivosti a owl:DatatypeProperty ;
  rdfs:label "zpracování statistických hlášení o myslivosti"@cs ;
  skos:prefLabel "zpracování statistických hlášení o myslivosti"@cs ;
  skos:definition "Zpracování statistických hlášení o myslivosti je činnost kraje v přenesené působnosti podle § 38."@cs ;
  dcterms:description "Kraj zpracovává statistická hlášení, která poskytují přehled o stavu a vývoji myslivosti v regionu."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:podíl-na-vzdělávání-v-myslivosti a owl:DatatypeProperty ;
  rdfs:label "podíl na vzdělávání v myslivosti"@cs ;
  skos:prefLabel "podíl na vzdělávání v myslivosti"@cs ;
  skos:definition "Podíl na vzdělávání v myslivosti a mysliveckém výzkumu je činnost kraje v přenesené působnosti."@cs ;
  dcterms:description "Kraj se podílí na vzdělávání a výzkumu v oblasti myslivosti, což přispívá k rozvoji znalostí a dovedností v této oblasti."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:spolupráce-s-občanskými-sdruženími a owl:DatatypeProperty ;
  rdfs:label "spolupráce s občanskými sdruženími"@cs ;
  skos:prefLabel "spolupráce s občanskými sdruženími"@cs ;
  skos:definition "Spolupráce s občanskými sdruženími, které působí v myslivosti, a ostatní veřejností je činnost kraje v přenesené působnosti."@cs ;
  dcterms:description "Kraj spolupracuje s občanskými sdruženími a veřejností, což podporuje komunitní zapojení a spolupráci v oblasti myslivosti."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:kontrola-dodržování-podmínek-poskytování-finančních-příspěvků a owl:DatatypeProperty ;
  rdfs:label "kontrola dodržování podmínek poskytování finančních příspěvků"@cs ;
  skos:prefLabel "kontrola dodržování podmínek poskytování finančních příspěvků"@cs ;
  skos:definition "Kontrola dodržování podmínek poskytování finančních příspěvků je činnost kraje v přenesené působnosti podle § 62 odst. 1."@cs ;
  dcterms:description "Kraj provádí kontrolu, zda jsou dodržovány podmínky pro poskytování finančních příspěvků, což zajišťuje správné využití těchto prostředků."@cs ;
  rdfs:domain :Kraj ;
  rdfs:range xsd:boolean .

:organizátor-chovatelské-přehlídky a owl:DatatypeProperty ;
  rdfs:label "organizátor chovatelské přehlídky"@cs ;
  skos:prefLabel "organizátor chovatelské přehlídky"@cs ;
  skos:definition "Organizátor chovatelské přehlídky je subjekt, kterému může být svěřeno pořádání chovatelské přehlídky orgány státní správy myslivosti."@cs ;
  dcterms:description "Organizátorem chovatelské přehlídky může být myslivecká organizace, která je pověřena organizací přehlídky orgány státní správy myslivosti."@cs ;
  rdfs:domain :Chovatelská-přehlídka ;
  rdfs:range xsd:string .

:způsob-uvědomění-o-chovatelské-přehlídce a owl:DatatypeProperty ;
  rdfs:label "způsob uvědomění o chovatelské přehlídce"@cs ;
  skos:prefLabel "způsob uvědomění o chovatelské přehlídce"@cs ;
  skos:definition "Způsob uvědomění o chovatelské přehlídce je metoda, jakou jsou uživatelé honiteb informováni o pořádání a organizaci chovatelské přehlídky."@cs ;
  dcterms:description "Uživatelé honiteb jsou o chovatelské přehlídce informováni způsobem, který je v místě obvyklý, což může zahrnovat různé formy komunikace, jako jsou oznámení na nástěnkách, e-maily nebo jiné místně uznávané metody."@cs ;
  rdfs:domain :Chovatelská-přehlídka ;
  rdfs:range xsd:string .

:územní-obvod-působnosti-hodnotitelské-komise a owl:DatatypeProperty ;
  rdfs:label "územní obvod působnosti hodnotitelské komise"@cs ;
  skos:prefLabel "územní obvod působnosti hodnotitelské komise"@cs ;
  skos:definition "Územní obvod, ve kterém je hodnotitelská komise oprávněna působit při hodnocení trofejí na chovatelských přehlídkách."@cs ;
  dcterms:description "Hodnotitelská komise je ustavena orgány státní správy myslivosti a její působnost je omezena na konkrétní územní obvod, kde se konají chovatelské přehlídky."@cs ;
  rdfs:domain :Hodnotitelská-komise ;
  rdfs:range xsd:string .

:typ-trofeje a owl:DatatypeProperty ;
  rdfs:label "typ trofeje"@cs ;
  skos:prefLabel "typ trofeje"@cs ;
  skos:definition "Typ trofeje zahrnuje rohy, parohy, parůžky, zbraně u prasete divokého, lebky a kůže některých šelem."@cs ;
  dcterms:description "Typ trofeje určuje, o jakou část těla zvěře se jedná. Může zahrnovat rohy a parohy, které jsou odděleny od lebky, zbraně u prasete divokého, a lebky a kůže některých šelem."@cs ;
  rdfs:domain :Trofej ;
  rdfs:range xsd:string .

:medailová-bodová-hodnota-význačné-trofeje a owl:DatatypeProperty ;
  rdfs:label "medailová bodová hodnota význačné trofeje"@cs ;
  skos:prefLabel "medailová bodová hodnota význačné trofeje"@cs ;
  skos:definition "Medailová bodová hodnota význačné trofeje je bodové hodnocení, které trofej přesahuje podle metodiky Mezinárodní myslivecké organizace."@cs ;
  dcterms:description "Medailová bodová hodnota určuje, zda trofej dosahuje úrovně význačné trofeje. Hodnoty jsou stanoveny pro různé druhy zvěře, například jelen 215 bodů, sika japonský 260 bodů, a další."@cs ;
  rdfs:domain :Význačná-trofej ;
  rdfs:range xsd:integer .

:evidence-význačných-trofejí a owl:DatatypeProperty ;
  rdfs:label "evidence význačných trofejí"@cs ;
  skos:prefLabel "evidence význačných trofejí"@cs ;
  skos:definition "Evidence význačných trofejí je vedena mysliveckou organizací pověřenou ústředním orgánem státní správy myslivosti."@cs ;
  dcterms:description "Evidence význačných trofejí zahrnuje záznamy o trofejích, které přesahují medailové bodové hodnoty podle metodiky Mezinárodní myslivecké organizace. Tato evidence je důležitá pro sledování a hodnocení význačných trofejí v České republice."@cs ;
  rdfs:domain :Ústřední-hodnotitelská-komise ;
  rdfs:range xsd:string .

:člen-ústřední-hodnotitelské-komise a owl:DatatypeProperty ;
  rdfs:label "člen ústřední hodnotitelské komise"@cs ;
  skos:prefLabel "člen ústřední hodnotitelské komise"@cs ;
  skos:definition "Člen ústřední hodnotitelské komise je osoba oprávněná hodnotit význačné trofeje před jejich vývozem do zahraničí."@cs ;
  dcterms:description "Každá význačná trofej musí být ohodnocena alespoň jedním členem ústřední hodnotitelské komise před jejím vývozem do zahraničí. Tento člen je zodpovědný za vystavení hodnotitelské tabulky a pořízení fotodokumentace trofeje."@cs ;
  rdfs:domain :Ústřední-hodnotitelská-komise ;
  rdfs:range xsd:string .

:oprávnění-nosit-služební-stejnokroj a owl:DatatypeProperty ;
  rdfs:label "oprávnění nosit služební stejnokroj"@cs ;
  skos:prefLabel "oprávnění nosit služební stejnokroj"@cs ;
  skos:definition "Oprávnění nosit služební stejnokroj je právo odborného zaměstnance orgánu státní správy myslivosti nosit uniformu při výkonu své funkce."@cs ;
  dcterms:description "Odborní zaměstnanci orgánů státní správy myslivosti mají právo nosit služební stejnokroj, což je součástí jejich pracovního vybavení při výkonu funkce. Toto oprávnění je stanoveno zákonem a vyhláškou."@cs ;
  rdfs:domain :Odborný-zaměstnanec-orgánu-státní-správy-myslivosti ;
  rdfs:range xsd:boolean .

:podrobnosti-o-služebním-stejnokroji a owl:DatatypeProperty ;
  rdfs:label "podrobnosti o služebním stejnokroji"@cs ;
  skos:prefLabel "podrobnosti o služebním stejnokroji"@cs ;
  skos:definition "Podrobnosti o služebním stejnokroji zaměstnanců orgánů státní správy myslivosti jsou stanoveny vyhláškou."@cs ;
  dcterms:description "Podrobnosti zahrnují specifikace a pravidla pro nošení služebního stejnokroje odbornými zaměstnanci orgánů státní správy myslivosti. Tyto podrobnosti jsou určeny vyhláškou, která stanoví, jak má stejnokroj vypadat a jak má být označen."@cs ;
  rdfs:domain :Služební-stejnokroj ;
  rdfs:range xsd:string .

:účel-finančního-příspěvku a owl:DatatypeProperty ;
  rdfs:label "účel finančního příspěvku"@cs ;
  skos:prefLabel "účel finančního příspěvku"@cs ;
  skos:definition "Účel, na který může být finanční příspěvek poskytnut, zahrnuje zlepšování životního prostředí zvěře, podporu ohrožených druhů zvěře, oborní chovy zvěře se vzácnými druhy nebo poddruhy, chov a výcvik národních plemen loveckých psů a loveckých dravců, použití dravců v ochraně rostlin, preventivní veterinárně léčebné akce a zdolávání nákaz v chovech zvěře, ozeleňování krajiny včetně oplocování dřevin, chovatelské přehlídky a myslivecké výstavy, propagaci a osvětu myslivosti, zařízení pro selektivní lov a odchyt dalších živočichů vyžadujících regulaci."@cs ;
  dcterms:description "Finanční příspěvek může být poskytnut na různé účely, které podporují myslivecké hospodaření a ochranu přírody. Tyto účely zahrnují aktivity jako zlepšování životního prostředí pro zvěř, podpora ohrožených druhů, chov vzácných druhů zvěře, výcvik loveckých psů a dravců, a další činnosti, které přispívají k udržitelnému rozvoji a ochraně přírody."@cs ;
  rdfs:domain :Finanční-příspěvek ;
  rdfs:range xsd:string .

:pravidla-poskytování-finančního-příspěvku a owl:DatatypeProperty ;
  rdfs:label "pravidla poskytování finančního příspěvku"@cs ;
  skos:prefLabel "pravidla poskytování finančního příspěvku"@cs ;
  skos:definition "Pravidla poskytování finančního příspěvku se stanoví v rámci pravidel podpory hospodaření v lesích a pravidel používání prostředků z Fondu životního prostředí."@cs ;
  dcterms:description "Poskytování finančních příspěvků se řídí specifickými pravidly, která jsou součástí širších pravidel pro podporu hospodaření v lesích a využívání prostředků z Fondu životního prostředí. Tato pravidla určují podmínky a postupy pro získání finančního příspěvku."@cs ;
  rdfs:domain :Finanční-příspěvek ;
  rdfs:range xsd:string .

:nárok-na-finanční-příspěvek a owl:DatatypeProperty ;
  rdfs:label "nárok na finanční příspěvek"@cs ;
  skos:prefLabel "nárok na finanční příspěvek"@cs ;
  skos:definition "Na poskytnutí finančního příspěvku není právní nárok."@cs ;
  dcterms:description "I když stát poskytuje finanční příspěvky na podporu mysliveckého hospodaření, neexistuje právní nárok na jejich získání. To znamená, že příspěvek může být poskytnut, ale není zaručen."@cs ;
  rdfs:domain :Finanční-příspěvek ;
  rdfs:range xsd:boolean .

:vrácení-finančního-příspěvku a owl:DatatypeProperty ;
  rdfs:label "vrácení finančního příspěvku"@cs ;
  skos:prefLabel "vrácení finančního příspěvku"@cs ;
  skos:definition "Příjemce je povinen vrátit finanční příspěvek v plné výši, pokud byl poskytnut na základě nepravdivých nebo nesprávných údajů nebo nebyl použit na účel, na který byl poskytnut."@cs ;
  dcterms:description "Pokud příjemce obdrží finanční příspěvek na základě nesprávných informací nebo jej nepoužije na stanovený účel, musí příspěvek vrátit. Tato povinnost zajišťuje, že finanční prostředky jsou využívány správně a efektivně."@cs ;
  rdfs:domain :Finanční-příspěvek ;
  rdfs:range xsd:boolean .

:druh-přestupku a owl:DatatypeProperty ;
  rdfs:label "druh přestupku"@cs ;
  skos:prefLabel "druh přestupku"@cs ;
  skos:definition "Druh přestupku určuje konkrétní jednání, kterým byla porušena povinnost stanovená zákonem."@cs ;
  dcterms:description "Druh přestupku může zahrnovat různé typy porušení, jako je nesplnění povinností podle specifických paragrafů zákona, neoprávněný lov zvěře nebo jiné protiprávní jednání."@cs ;
  rdfs:domain :Přestupek ;
  rdfs:range xsd:string .

:výše-pokuty-za-přestupek a owl:DatatypeProperty ;
  rdfs:label "výše pokuty za přestupek"@cs ;
  skos:prefLabel "výše pokuty za přestupek"@cs ;
  skos:definition "Výše pokuty je maximální částka, kterou lze uložit za spáchání přestupku."@cs ;
  dcterms:description "Pokuta je finanční sankce, která může být uložena za přestupek. Výše pokuty se liší podle závažnosti přestupku a může být zvýšena, pokud je přestupek spáchán opakovaně."@cs ;
  rdfs:domain :Přestupek ;
  rdfs:range xsd:integer .

:opakování-přestupku a owl:DatatypeProperty ;
  rdfs:label "opakování přestupku"@cs ;
  skos:prefLabel "opakování přestupku"@cs ;
  skos:definition "Opakování přestupku nastává, pokud je přestupek spáchán znovu do 12 měsíců od nabytí právní moci rozhodnutí o stejném přestupku."@cs ;
  dcterms:description "Pokud je přestupek spáchán opakovaně, může být pokuta zvýšena až na dvojnásobek horní hranice sazby. Opakování je definováno jako spáchání stejného přestupku do jednoho roku od předchozího rozhodnutí."@cs ;
  rdfs:domain :Přestupek ;
  rdfs:range xsd:boolean .

:výše-pokuty a owl:DatatypeProperty ;
  rdfs:label "výše pokuty"@cs ;
  skos:prefLabel "výše pokuty"@cs ;
  skos:definition "Výše pokuty je částka, která může být uložena za přestupek podle tohoto zákona."@cs ;
  dcterms:description "Výše pokuty může být až dvojnásobek horní hranice sazeb, pokud je přestupek spáchán opakovaně do 12 měsíců od nabytí právní moci rozhodnutí o stejném přestupku."@cs ;
  rdfs:domain :Pokuta ;
  rdfs:range xsd:integer .

:příjemce-výnosu-z-pokuty a owl:DatatypeProperty ;
  rdfs:label "příjemce výnosu z pokuty"@cs ;
  skos:prefLabel "příjemce výnosu z pokuty"@cs ;
  skos:definition "Příjemce výnosu z pokuty je subjekt, který obdrží finanční prostředky z pokuty uložené za přestupek."@cs ;
  dcterms:description "Výnosy z pokut uložených mysliveckou stráží za přestupky podle § 63 jsou příjmem příslušné obce s rozšířenou působností. Výnosy z pokut uložených za přestupky podle § 64 jsou příjmem Státního fondu životního prostředí."@cs ;
  rdfs:domain :Pokuta ;
  rdfs:range xsd:string .

:výměra-samostatné-bažantnice a owl:DatatypeProperty ;
  rdfs:label "výměra samostatné bažantnice"@cs ;
  skos:prefLabel "výměra samostatné bažantnice"@cs ;
  skos:definition "Výměra samostatné bažantnice je plocha území, které bylo uznáno podle dosavadních předpisů a nyní se stává honitbou podle nového zákona, i když nedosahuje výměry 500 ha."@cs ;
  dcterms:description "Výměra samostatné bažantnice určuje velikost území, které bylo dříve uznáno jako samostatná bažantnice a nyní je považováno za honitbu podle nového zákona. I když nedosahuje standardní výměry 500 ha, je stále uznáno jako honitba."@cs ;
  rdfs:domain :Samostatná-bažantnice ;
  rdfs:range xsd:integer .

:souhlas-orgánu-státní-správy-myslivosti a owl:DatatypeProperty ;
  rdfs:label "souhlas orgánu státní správy myslivosti"@cs ;
  skos:prefLabel "souhlas orgánu státní správy myslivosti"@cs ;
  skos:definition "Souhlas orgánu státní správy myslivosti je nezbytný pro chov zvěře v zajetí, s výjimkou chovu v zoologické zahradě zřízené obcí nebo krajem a držení a chovu loveckých dravců."@cs ;
  dcterms:description "Pro legální chov zvěře v zajetí je nutné získat souhlas od příslušného orgánu státní správy myslivosti, pokud se nejedná o specifické výjimky jako je chov v obecní nebo krajské zoologické zahradě nebo chov loveckých dravců."@cs ;
  rdfs:domain :Chov-zvěře-v-zajetí ;
  rdfs:range xsd:boolean .

:vyjádření-veterinárních-orgánů a owl:DatatypeProperty ;
  rdfs:label "vyjádření veterinárních orgánů"@cs ;
  skos:prefLabel "vyjádření veterinárních orgánů"@cs ;
  skos:definition "Vyjádření veterinárních orgánů je součástí žádosti o udělení souhlasu k chovu zvěře v zajetí."@cs ;
  dcterms:description "Při žádosti o souhlas k chovu zvěře v zajetí je nutné předložit vyjádření od veterinárních orgánů, které posoudí navrhované podmínky chovu."@cs ;
  rdfs:domain :Chov-zvěře-v-zajetí ;
  rdfs:range xsd:string .

:vyjádření-orgánů-na-ochranu-zvířat-proti-týrání a owl:DatatypeProperty ;
  rdfs:label "vyjádření orgánů na ochranu zvířat proti týrání"@cs ;
  skos:prefLabel "vyjádření orgánů na ochranu zvířat proti týrání"@cs ;
  skos:definition "Vyjádření orgánů na ochranu zvířat proti týrání je součástí žádosti o udělení souhlasu k chovu zvěře v zajetí."@cs ;
  dcterms:description "Při žádosti o souhlas k chovu zvěře v zajetí je nutné předložit vyjádření od orgánů na ochranu zvířat proti týrání, které posoudí navrhované podmínky chovu."@cs ;
  rdfs:domain :Chov-zvěře-v-zajetí ;
  rdfs:range xsd:string .

:podmínky-pro-dočasné-držení-lišky-obecné a owl:DatatypeProperty ;
  rdfs:label "podmínky pro dočasné držení lišky obecné"@cs ;
  skos:prefLabel "podmínky pro dočasné držení lišky obecné"@cs ;
  skos:definition "Podmínky pro dočasné držení lišky obecné v zajetí pro účely výcviku psů loveckých plemen stanoví orgán státní správy myslivosti a orgán na ochranu zvířat proti týrání."@cs ;
  dcterms:description "Pro dočasné držení lišky obecné v zajetí za účelem výcviku loveckých psů je nutné dodržet podmínky stanovené příslušnými orgány, které mohou zahrnovat specifické požadavky na péči a zacházení se zvířaty."@cs ;
  rdfs:domain :Chov-zvěře-v-zajetí ;
  rdfs:range xsd:string .

:zrušené-právní-předpisy a owl:DatatypeProperty ;
  rdfs:label "zrušené právní předpisy"@cs ;
  skos:prefLabel "zrušené právní předpisy"@cs ;
  skos:definition "Zrušené právní předpisy jsou zákony nebo jejich části, které jsou zrušeny zrušovacím ustanovením."@cs ;
  dcterms:description "Tento atribut obsahuje seznam zákonů, které byly zrušeny zrušovacím ustanovením. Například zákon č. 23/1962 Sb., o myslivosti, a jeho následné novely byly zrušeny."@cs ;
  rdfs:domain :Zrušovací-ustanovení ;
  rdfs:range xsd:string .

:ochrana-zvěře-před-nepříznivými-vlivy-prostředí a owl:DatatypeProperty ;
  rdfs:label "ochrana zvěře před nepříznivými vlivy prostředí"@cs ;
  skos:prefLabel "ochrana zvěře před nepříznivými vlivy prostředí"@cs ;
  skos:definition "Ochrana zvěře před nepříznivými vlivy prostředí zahrnuje opatření k ochraně zvěře před negativními vlivy, které mohou pocházet z okolního prostředí."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na minimalizaci škodlivých vlivů prostředí, které mohou ohrozit zdraví a pohodu zvěře."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:ochrana-zvěře-před-nakažlivými-nemocemi a owl:DatatypeProperty ;
  rdfs:label "ochrana zvěře před nakažlivými nemocemi"@cs ;
  skos:prefLabel "ochrana zvěře před nakažlivými nemocemi"@cs ;
  skos:definition "Ochrana zvěře před nakažlivými nemocemi zahrnuje opatření k prevenci a kontrole šíření nemocí mezi zvěří."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na prevenci a kontrolu nemocí, které mohou ohrozit zdraví zvěře."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:ochrana-zvěře-před-škodlivými-zásahy-lidí a owl:DatatypeProperty ;
  rdfs:label "ochrana zvěře před škodlivými zásahy lidí"@cs ;
  skos:prefLabel "ochrana zvěře před škodlivými zásahy lidí"@cs ;
  skos:definition "Ochrana zvěře před škodlivými zásahy lidí zahrnuje opatření k ochraně zvěře před negativními vlivy způsobenými lidskou činností."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na minimalizaci škodlivých vlivů lidské činnosti, které mohou ohrozit zdraví a pohodu zvěře."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:ochrana-zvěře-před-volně-pobíhajícími-domácími-zvířaty a owl:DatatypeProperty ;
  rdfs:label "ochrana zvěře před volně pobíhajícími domácími zvířaty"@cs ;
  skos:prefLabel "ochrana zvěře před volně pobíhajícími domácími zvířaty"@cs ;
  skos:definition "Ochrana zvěře před volně pobíhajícími domácími zvířaty zahrnuje opatření k ochraně zvěře před negativními vlivy způsobenými volně pobíhajícími domácími zvířaty."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na minimalizaci škodlivých vlivů volně pobíhajících domácích zvířat, které mohou ohrozit zdraví a pohodu zvěře."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:ochrana-životních-podmínek-zvěře a owl:DatatypeProperty ;
  rdfs:label "ochrana životních podmínek zvěře"@cs ;
  skos:prefLabel "ochrana životních podmínek zvěře"@cs ;
  skos:definition "Ochrana životních podmínek zvěře zahrnuje opatření k ochraně a zlepšení podmínek, ve kterých zvěř žije."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na zajištění a zlepšení podmínek prostředí, které jsou nezbytné pro zdraví a pohodu zvěře."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:zajištění-klidu-v-honitbě a owl:DatatypeProperty ;
  rdfs:label "zajištění klidu v honitbě"@cs ;
  skos:prefLabel "zajištění klidu v honitbě"@cs ;
  skos:definition "Zajištění klidu v honitbě zahrnuje opatření k udržení klidného prostředí v oblastech, kde se zvěř pohybuje."@cs ;
  dcterms:description "Tato opatření se zaměřují na minimalizaci rušivých vlivů, které by mohly narušit klid a pohodu zvěře v honitbě."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:ochrana-mysliveckých-zařízení a owl:DatatypeProperty ;
  rdfs:label "ochrana mysliveckých zařízení"@cs ;
  skos:prefLabel "ochrana mysliveckých zařízení"@cs ;
  skos:definition "Ochrana mysliveckých zařízení zahrnuje opatření k ochraně zařízení používaných v myslivosti před poškozením nebo zničením."@cs ;
  dcterms:description "Tato ochrana se zaměřuje na udržení a ochranu zařízení, která jsou nezbytná pro efektivní výkon myslivosti."@cs ;
  rdfs:domain :Ochrana-myslivosti ;
  rdfs:range xsd:boolean .

:souhlas-vlastníka-honebního-pozemku a owl:DatatypeProperty ;
  rdfs:label "souhlas vlastníka honebního pozemku"@cs ;
  skos:prefLabel "souhlas vlastníka honebního pozemku"@cs ;
  skos:definition "Souhlas vlastníka honebního pozemku je nutný k vybudování a umístění mysliveckého zařízení."@cs ;
  dcterms:description "Před vybudováním nebo umístěním mysliveckého zařízení, jako jsou slaniska nebo napajedla, je třeba získat souhlas od vlastníka honebního pozemku. Pokud žádný z vlastníků honebních pozemků v honitbě tento souhlas nedá, rozhodne o umístění zařízení orgán státní správy myslivosti."@cs ;
  rdfs:domain :Myslivecké-zařízení ;
  rdfs:range xsd:boolean .


# Přístupový klíč k OpenAPI.
OPENAI_API_KEY="sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Kam backend posiela volania modelu. Prázdne = https://api.openai.com/v1
# OpenAI-kompatibilný endpoint, napríklad e-INFRA CZ:
# OPENAI_BASE_URL=https://llm.ai.e-infra.cz/v1/
OPENAI_BASE_URL=
# Konfigurace přístupu uživatelů.
USER_KEYS=

# Modely pro agenty. Nepovinné – bez nich se použijí výchozí hodnoty uvedené níže.
# Pokud projekt tvého API klíče nemá přístup k některému modelu, přepiš ho zde.
# Musí jít o reasoning model (rodina gpt-5, o-series), protože agenti volají
# Responses API s parametry `reasoning` a `verbosity`.
# Hlavní model: plánování úloh a návrh iterací.
OPENAI_MODEL=gpt-5
# Levnější model: modeler a analýza doménových oblastí.
OPENAI_MODEL_MINI=gpt-5-mini

# Kľúč z chat.ai.e-infra.cz (Účet → API keys). Nie je to kľúč z platform.openai.com.
OPENAI_API_KEY="sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# OpenAI-kompatibilný endpoint e-INFRA CZ.
OPENAI_BASE_URL=https://llm.ai.e-infra.cz/v1/
# Konfigurace přístupu uživatelů.
USER_KEYS=

# Generatívne modely e-INFRA. Alias mini dnes ukazuje na gpt-oss-120b.
# Dá sa nahradiť iným aliasom alebo presným názvom: kimi, deepseek, glm, coder, gpt-oss-120b, ...
# Hlavný model: plánovanie úloh a návrh iterácií.
OPENAI_MODEL=mini
# Druhý model: modeler, analýza doménových oblastí a sumarizácia.
OPENAI_MODEL_MINI=mini
# Embeddingy na tom istom endpointe. qwen3-embedding-4b má vektory dĺžky 2560.
OPENAI_EMBEDDING_MODEL=qwen3-embedding-4b
OPENAI_EMBEDDING_DIMENSION=2560
